@using CACI_Life.Core.Domain.Congregations
@inject ICongregationService CongregationService

<footer class="bg-caci-minister text-white mt-16" aria-label="Site footer">
    <div class="max-w-6xl mx-auto px-4 py-12 grid gap-10 md:grid-cols-3">
        <section>
            <a href="@($"/congregation/{_profile.UrlSlug}")" class="logo-plate" aria-label="@(_profile.CongregationName) home">
                <img src="@(_profile.EffectiveLogo)" alt="@(_profile.CongregationName)" width="140" height="117" class="h-24 sm:h-28 w-auto" />
            </a>
            <p class="mt-4 text-sm text-slate-200">@(_profile.RegionDescription)</p>
            @if (!string.IsNullOrWhiteSpace(_profile.FacebookUrl) || !string.IsNullOrWhiteSpace(_profile.YouTubeUrl))
            {
                <p class="mt-3 text-sm">
                    @if (!string.IsNullOrWhiteSpace(_profile.FacebookUrl))
                    {
                        <a class="text-white font-semibold underline" href="@(_profile.FacebookUrl)" rel="noopener" target="_blank">Facebook</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(_profile.FacebookUrl) && !string.IsNullOrWhiteSpace(_profile.YouTubeUrl))
                    {
                        <span aria-hidden="true"> · </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_profile.YouTubeUrl))
                    {
                        <a class="text-white font-semibold underline" href="@(_profile.YouTubeUrl)" rel="noopener" target="_blank">YouTube</a>
                    }
                </p>
            }
        </section>

        <nav aria-label="Footer">
            <h2 class="font-head text-xl text-white">Explore</h2>
            <div class="section-rule my-3"></div>
            <ul class="space-y-2 text-sm">
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/what-we-believe")">What We Believe</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/sabbath")">Why The Sabbath</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/bible-studies")">Bible Studies</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/teachings")">Apostolic Teachings</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/4keys")">4 Keys of the Kingdom</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/foundations")">12 Foundations Bible Study</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/feasts")">Biblical Feasts (Moedim)</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/calendar")">CACI Community Calendar</a></li>
                <li><a class="text-white hover:text-caci-tone3" href="@($"/congregation/{_profile.UrlSlug}/connect")">Connect With Us</a></li>
                @if (!string.IsNullOrWhiteSpace(_profile.EffectiveGivingUrl))
                {
                    <li><a class="text-amber-300 font-semibold hover:text-amber-200" href="@(_profile.EffectiveGivingUrl)" target="_blank" rel="noopener">Giving (CACI Fellowship)</a></li>
                }
            </ul>
        </nav>

        <section>
            <h2 class="font-head text-xl text-white">Our Fellowship</h2>
            <div class="section-rule my-3"></div>
            <a href="https://caci.life" class="logo-plate" rel="noopener" aria-label="Covenant Apostolic Congregations International">
                <img src="/logos/CACI_Logo.png" alt="Covenant Apostolic Congregations, Intl. - All the Word to All the World" width="120" height="120" class="h-24 w-auto" />
            </a>
            <p class="mt-4 text-sm text-slate-200">
                @(_profile.CongregationName) is a constituent fellowship of
                <a class="text-white font-semibold underline" href="https://caci.life" rel="noopener">Covenant Apostolic Congregations International (CACI)</a>.
            </p>
            <p class="mt-3 text-sm">
                <a class="text-amber-300 font-semibold hover:text-amber-200" href="/congregations">&larr; Find All Congregations</a>
            </p>
        </section>
    </div>
    <div class="border-t border-white/15">
        <p class="max-w-6xl mx-auto px-4 py-4 text-xs text-slate-300">&copy; @DateTime.UtcNow.Year @(_profile.CongregationName). All rights reserved.</p>
    </div>
</footer>

@code {
    private CongregationProfile _profile = new();

    protected override async Task OnInitializedAsync()
    {
        _profile = await CongregationService.GetCurrentAsync();
    }
}
