                                            Request Free Study on Foundation @f.SeriesOrder
                                        </a>
                                        <a href="@($"/congregation/{_profile.UrlSlug}/foundations/{f.Slug}")" class="text-xs font-bold text-caci-minister hover:underline">
                                            Read Full Study →
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </details>
                    </div>
                }
            </div>
