@page "/congregation/{Slug}/foundations"
@page "/congregation/{Slug}/12Foundations"
@layout CongregationLayout
@using CACI_Life.Core.Domain.Congregations
@using CACI_Life.Features.Congregations.Queries
@inject ICongregationService CongregationService
@inject TenantContext TenantContext
@inject GetFoundationsQueries Queries

<CongregationSeoHead Title="The 12 Foundations Bible Study | God's Kingdom Blueprint"
         Description="Learn the 12 Foundations to understanding your Bible from Genesis to Revelation. Discover the Kingdom Blueprint, the 4 marks of the Bible, and God's prophetic plan."
         Path="@($"/congregation/{_profile.UrlSlug}/foundations")" />

<!-- Hero Section -->
<section class="hero relative overflow-hidden py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
        <span class="inline-block py-1 px-4 rounded-full text-xs md:text-sm font-semibold tracking-wider uppercase bg-amber-400 text-slate-900 shadow-md mb-4">
            ~ 12 Foundations ~ To Understanding Your Bible
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
            God's Kingdom Blueprint
        </h1>
        <p class="mt-4 text-xl md:text-2xl text-caci-tone3 font-medium italic">
            “All The Word To All The World”
        </p>
        <p class="mt-6 text-base md:text-lg text-slate-100 max-w-3xl mx-auto leading-relaxed">
            Understanding the Bible isn't just for pastors and scholars. We all should be able to read and understand the Word that God has preserved for us. 
            <strong>No Bible college needed. No human creeds. Only your Bible.</strong> 
            There are 12 major events and time periods that take us from the fall of man to God's plan coming to fruition. You won't hear this taught in modern church!
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="https://caci.life/foundations/lesson/1?ref=kca" target="_blank" rel="noopener" class="btn-primary btn-red font-bold px-7 py-3 text-base shadow-lg">
                Take Lessons 1–3 Online Free &nearr;
            </a>
            <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=12%20Foundations%20-%20Hero%20Banner&topic=12%20Foundations%20Bible%20Study" class="btn-primary btn-amber font-bold px-6 py-3 text-base shadow-lg">
                Request In-Person Study with an Elder
            </a>
            <a href="#foundations-grid" class="btn-hero-secondary font-semibold px-6 py-3 text-base">
                View 12 Foundations Syllabus &darr;
            </a>
            <a href="https://caci.life/portal/foundations" target="_blank" rel="noopener" class="btn-hero-secondary font-semibold px-6 py-3 text-base">
                Minister Portal 🔒
            </a>
        </div>
    </div>
</section>

<!-- Main Container -->
<div class="max-w-6xl mx-auto px-4 py-12 md:py-16 space-y-20">

    <!-- Section 1: Intro Pillars (Lesson 1: The Blueprint) -->
    <section id="intro-blueprint" class="space-y-12">
        <div class="text-center max-w-3xl mx-auto">
            <p class="text-sm font-bold uppercase tracking-widest text-caci-purple">Lesson 1: Introduction to Your Bible</p>
            <h2 class="text-3xl md:text-4xl font-bold mt-2">Why Study the 12 Foundations?</h2>
            <div class="section-rule mx-auto my-4"></div>
            <p class="text-slate-600 text-base md:text-lg">
                Before building a house, you need a blueprint. Before studying doctrine, you need the overarching timeline of Scripture. Here is the foundation upon which all 66 books rest.
            </p>
        </div>

        <!-- Home Bible Study & Truth vs Tradition Grid -->
        <div class="grid md:grid-cols-2 gap-8">
            <!-- Home Bible Study Pillar -->
            <div class="card p-6 md:p-8 border-t-4 border-t-caci-blue">
                <div class="w-12 h-12 rounded-xl bg-caci-blue/10 text-caci-blue flex items-center justify-center mb-5">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                </div>
                <h3 class="text-2xl font-bold text-caci-blue">The Home Bible Study Pattern</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">
                    The early believers did not depend on institutional hierarchies. They gathered in homes, opened the Scriptures, and learned together in genuine fellowship:
                </p>
                <ul class="mt-4 space-y-3 text-sm text-slate-700">
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-caci-minister shrink-0">Acts 5:42 —</span>
                        <span><em>“Every day, in the temple and in every house, they never stopped teaching and preaching Jesus, the Messiah.”</em></span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-caci-minister shrink-0">Acts 20:20 —</span>
                        <span><em>“I didn't shrink from declaring to you anything that was profitable, teaching you publicly and from house to house.”</em></span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-caci-minister shrink-0">Malachi 3:16 —</span>
                        <span><em>“Then those who feared Yahweh spoke one with another; and Yahweh listened and heard, and a book of remembrance was written.”</em></span>
                    </li>
                </ul>
            </div>

            <!-- Truth or Traditions Pillar -->
            <div class="card p-6 md:p-8 border-t-4 border-t-caci-purple">
                <div class="w-12 h-12 rounded-xl bg-caci-purple/10 text-caci-purple flex items-center justify-center mb-5">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                </div>
                <h3 class="text-2xl font-bold text-caci-purple">Truth vs. Human Traditions</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">
                    Will we trust the commandments of God, or human customs handed down through pagan culture and church history?
                </p>
                <ul class="mt-4 space-y-3 text-sm text-slate-700">
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-caci-purple shrink-0">John 17:17 —</span>
                        <span><em>“Sanctify them in the truth; your word is truth.”</em></span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-caci-purple shrink-0">Matthew 22:29 —</span>
                        <span><em>“Jesus replied, ‘Your error is not knowing the Scriptures.’”</em></span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-caci-purple shrink-0">Acts 17:11 —</span>
                        <span><em>“They received the word with all eagerness... examining the Scriptures daily to see if these things were so.”</em></span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-caci-purple shrink-0">Mark 7:9 —</span>
                        <span><em>“You reject the commandment of God, that you may keep your own tradition.”</em></span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- 4 Divine Marks of the Bible -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-10 shadow-sm space-y-8">
            <div class="text-center max-w-2xl mx-auto">
                <span class="badge mb-2">Evidence for Faith</span>
                <h3 class="text-2xl md:text-3xl font-bold text-caci-blue">There Is No Book Like The Bible</h3>
                <p class="mt-2 text-slate-600 text-sm md:text-base">Four supernatural signatures that prove the Bible is the literal, inspired Word of God.</p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Mark 1: Origin -->
                <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                    <div>
                        <div class="text-caci-minister font-bold text-xs uppercase tracking-wider mb-2">1. Divine Origin</div>
                        <h4 class="font-bold text-lg text-slate-900">Moved by the Spirit</h4>
                        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
                            Written by over 40 authors across 1,500 years in 3 languages, yet speaking with one unified voice without contradiction.
                        </p>
                    </div>
                    <p class="mt-4 text-xs font-semibold text-caci-blue border-t border-slate-200 pt-3">
                        2 Peter 1:20-21 &middot; Jer 30:2 &middot; Ex 32:16
                    </p>
                </div>

                <!-- Mark 2: Knowledge -->
                <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                    <div>
                        <div class="text-caci-minister font-bold text-xs uppercase tracking-wider mb-2">2. Divine Knowledge</div>
                        <h4 class="font-bold text-lg text-slate-900">Science Ahead of Time</h4>
                        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
                            Scientific facts written millennia before discovery: the uncountable stars (Jer 33:22), the life in the blood (Lev 17:11), and the circle of the earth (Isa 40:22).
                        </p>
                    </div>
                    <p class="mt-4 text-xs font-semibold text-caci-blue border-t border-slate-200 pt-3">
                        Jer 33:22 &middot; Lev 17:11 &middot; Isa 40:22
                    </p>
                </div>

                <!-- Mark 3: Prophecy -->
                <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                    <div>
                        <div class="text-caci-minister font-bold text-xs uppercase tracking-wider mb-2">3. Divine Prophecy</div>
                        <h4 class="font-bold text-lg text-slate-900">End From Beginning</h4>
                        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
                            Over 300 specific Messianic prophecies written centuries before Jesus was born, fulfilled down to the exact birthplace, price of betrayal, and manner of death.
                        </p>
                    </div>
                    <p class="mt-4 text-xs font-semibold text-caci-blue border-t border-slate-200 pt-3">
                        Isa 46:9-10 &middot; Luke 24:27 &middot; Micah 5:2
                    </p>
                </div>

                <!-- Mark 4: Protection -->
                <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                    <div>
                        <div class="text-caci-minister font-bold text-xs uppercase tracking-wider mb-2">4. Divine Protection</div>
                        <h4 class="font-bold text-lg text-slate-900">Preserved Forever</h4>
                        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
                            Tyrants, empires, and skeptics have tried to burn and destroy it, yet the Scriptures remain preserved flawless as silver purified seven times.
                        </p>
                    </div>
                    <p class="mt-4 text-xs font-semibold text-caci-blue border-t border-slate-200 pt-3">
                        Psalm 12:6-7 &middot; Isaiah 40:8
                    </p>
                </div>
            </div>

            <!-- Toggleable Prophecy Proof Table -->
            <details class="faq-item">
                <summary class="text-base font-bold text-caci-blue">
                    <span>View Sample Messianic Prophecies: Foretold vs. Fulfilled</span>
                </summary>
                <div class="faq-answer overflow-x-auto pt-4">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 border-b border-slate-200">
                                <th class="p-3 font-bold">Event Foretold</th>
                                <th class="p-3 font-bold">Old Testament Prophecy</th>
                                <th class="p-3 font-bold">New Testament Fulfillment</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            <tr><td class="p-3 font-medium">Seed of Abraham</td><td class="p-3 text-caci-minister">Genesis 12:3; 22:18</td><td class="p-3 text-emerald-700">Galatians 3:16; Matt 1:1</td></tr>
                            <tr><td class="p-3 font-medium">Tribe of Judah</td><td class="p-3 text-caci-minister">Genesis 49:10</td><td class="p-3 text-emerald-700">Revelation 5:5; Luke 3:33</td></tr>
                            <tr><td class="p-3 font-medium">Born in Bethlehem</td><td class="p-3 text-caci-minister">Micah 5:2</td><td class="p-3 text-emerald-700">Matthew 2:1; Luke 2:4-7</td></tr>
                            <tr><td class="p-3 font-medium">Born of a Virgin</td><td class="p-3 text-caci-minister">Isaiah 7:14</td><td class="p-3 text-emerald-700">Matthew 1:18-23</td></tr>
                            <tr><td class="p-3 font-medium">Infants Killed</td><td class="p-3 text-caci-minister">Jeremiah 31:15</td><td class="p-3 text-emerald-700">Matthew 2:16</td></tr>
                            <tr><td class="p-3 font-medium">Flee to Egypt</td><td class="p-3 text-caci-minister">Hosea 11:1</td><td class="p-3 text-emerald-700">Matthew 2:15</td></tr>
                            <tr><td class="p-3 font-medium">Betrayed by a Friend</td><td class="p-3 text-caci-minister">Psalm 41:9</td><td class="p-3 text-emerald-700">Mark 14:10</td></tr>
                            <tr><td class="p-3 font-medium">Sold for 30 Pieces of Silver</td><td class="p-3 text-caci-minister">Zechariah 11:12-13</td><td class="p-3 text-emerald-700">Matthew 26:15; 27:3-9</td></tr>
                            <tr><td class="p-3 font-medium">Crucified with Transgressors</td><td class="p-3 text-caci-minister">Isaiah 53:12</td><td class="p-3 text-emerald-700">Matthew 27:38</td></tr>
                            <tr><td class="p-3 font-medium">Gall & Vinegar to Drink</td><td class="p-3 text-caci-minister">Psalm 69:21</td><td class="p-3 text-emerald-700">John 19:29</td></tr>
                            <tr><td class="p-3 font-medium">Pierced His Side</td><td class="p-3 text-caci-minister">Zechariah 12:10; Psalm 22:16</td><td class="p-3 text-emerald-700">John 19:34-37</td></tr>
                            <tr><td class="p-3 font-medium">Not One Bone Broken</td><td class="p-3 text-caci-minister">Psalm 34:20; Exodus 12:46</td><td class="p-3 text-emerald-700">John 19:32-36</td></tr>
                            <tr><td class="p-3 font-medium">Resurrection from the Dead</td><td class="p-3 text-caci-minister">Psalm 16:10</td><td class="p-3 text-emerald-700">Matthew 28:9; Acts 2:27-31</td></tr>
                        </tbody>
                    </table>
                </div>
            </details>
        </div>

        <!-- The 3rd Option: The Kingdom of God on Earth -->
        <div class="rounded-2xl bg-gradient-to-r from-caci-minister via-caci-blue to-caci-purple p-8 md:p-12 text-white shadow-xl">
            <div class="max-w-3xl mx-auto text-center space-y-4">
                <span class="inline-block px-3 py-1 text-xs font-bold rounded-full bg-amber-400 text-slate-900 uppercase tracking-wider">
                    The Great Paradigm Shift
                </span>
                <h3 class="text-3xl md:text-4xl font-extrabold text-white">
                    You've Heard of Heaven... You've Heard of Hell... <br class="hidden sm:inline" />
                    <span class="text-amber-300">Have You Ever Heard the 3rd Option?</span>
                </h3>
                <p class="text-slate-200 text-base md:text-lg leading-relaxed">
                    Mainstream theology teaches that salvation is leaving the earth to live in heaven forever. But what did Jesus and the prophets actually preach? 
                    <strong>The Gospel of the Kingdom of God on Earth!</strong>
                </p>
                <div class="grid sm:grid-cols-2 gap-4 text-left pt-4">
                    <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20">
                        <p class="text-amber-300 font-bold text-sm">Matthew 5:5</p>
                        <p class="text-sm text-slate-100 mt-1"><em>“Blessed are the meek: for they shall inherit the earth.”</em></p>
                    </div>
                    <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20">
                        <p class="text-amber-300 font-bold text-sm">Luke 11:2</p>
                        <p class="text-sm text-slate-100 mt-1"><em>“Thy kingdom come, Thy will be done on earth, as it is in heaven.”</em></p>
                    </div>
                    <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20">
                        <p class="text-amber-300 font-bold text-sm">Zechariah 14:9</p>
                        <p class="text-sm text-slate-100 mt-1"><em>“Yahweh shall be king over all the earth: in that day there shall be one Lord, and his name one.”</em></p>
                    </div>
                    <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20">
                        <p class="text-amber-300 font-bold text-sm">Revelation 21:2</p>
                        <p class="text-sm text-slate-100 mt-1"><em>“I John saw the holy city, new Jerusalem, coming down from God out of heaven to the earth.”</em></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 66 Books Architecture: OT Lost vs NT Restored -->
        <div class="grid md:grid-cols-2 gap-8">
            <div class="card p-6 md:p-8 bg-slate-50 border border-slate-200">
                <span class="badge mb-2">Part 1</span>
                <h4 class="text-2xl font-bold text-caci-blue">39 Old Testament Books</h4>
                <p class="text-sm font-semibold text-caci-red mt-1">How The Kingdom Was Lost</p>
                <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                    From Adam's lost dominion to the scattering of Israel's 10 northern tribes into the nations:
                </p>
                <ul class="mt-4 space-y-2 text-xs md:text-sm text-slate-700">
                    <li><strong class="text-slate-900">5 Books of Law (Torah):</strong> Genesis, Exodus, Leviticus, Numbers, Deuteronomy</li>
                    <li><strong class="text-slate-900">12 Books of History:</strong> Joshua to Esther</li>
                    <li><strong class="text-slate-900">5 Books of Poetry (Wisdom):</strong> Job, Psalms, Proverbs, Ecclesiastes, Song of Solomon</li>
                    <li><strong class="text-slate-900">17 Books of Prophecy:</strong> 5 Major Prophets &middot; 12 Minor Prophets</li>
                </ul>
            </div>

            <div class="card p-6 md:p-8 bg-slate-50 border border-slate-200">
                <span class="badge mb-2">Part 2</span>
                <h4 class="text-2xl font-bold text-caci-purple">27 New Testament Books</h4>
                <p class="text-sm font-semibold text-emerald-700 mt-1">How The Kingdom Is Restored</p>
                <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                    From Messiah's birth and blood atonement to the regathering of the lost sheep and the New Jerusalem:
                </p>
                <ul class="mt-4 space-y-2 text-xs md:text-sm text-slate-700">
                    <li><strong class="text-slate-900">4 Gospels:</strong> Matthew, Mark, Luke, John (The Life & Kingdom of Jesus)</li>
                    <li><strong class="text-slate-900">1 Book of History:</strong> Acts of the Apostles (The Holy Spirit & 2nd Exodus)</li>
                    <li><strong class="text-slate-900">13 Letters of Paul:</strong> Romans to Philemon (Grafting in the scattered sheep)</li>
                    <li><strong class="text-slate-900">8 General Epistles:</strong> Hebrews to Jude (To the 12 tribes scattered)</li>
                    <li><strong class="text-slate-900">1 Book of Prophecy:</strong> Revelation (The Return of the King & Paradise Restored)</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Section 2: Interactive Slide Presentation & Video Modules -->
    <section id="slide-viewer" class="space-y-10 pt-8 border-t border-slate-200">
        <div class="text-center max-w-3xl mx-auto">
            <p class="text-sm font-bold uppercase tracking-widest text-caci-purple">Visual Lesson Deck</p>
            <h2 class="text-3xl md:text-4xl font-bold mt-2">Lesson 1 Slide Presentation</h2>
            <div class="section-rule mx-auto my-4"></div>
            <p class="text-slate-600 text-base md:text-lg">
                Browse all 33 original slide visuals used in the <em>God's Kingdom Blueprint</em> Bible study teaching.
            </p>
        </div>

        <!-- Custom Slide Carousel Component (SSR compatible) -->
        <div class="bg-slate-900 rounded-2xl p-4 md:p-8 shadow-2xl text-white max-w-4xl mx-auto">
            <!-- Slide Image Frame -->
            <div class="relative aspect-[16/9] w-full rounded-xl overflow-hidden bg-black flex items-center justify-center border border-slate-800">
                <img id="kca-slide-img"
                     src="/images/foundations/lesson1/slide_01.png"
                     alt="Lesson 1 Slide Presentation"
                     class="w-full h-full object-contain select-none" />
            </div>

            <!-- Controls & Counter -->
            <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <button type="button" id="kca-prev-btn" onclick="prevSlide()" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-caci-tone2 text-white font-bold transition-colors flex items-center gap-2 text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        Previous
                    </button>
                    <button type="button" id="kca-next-btn" onclick="nextSlide()" class="px-4 py-2 rounded-lg bg-caci-blue hover:bg-caci-tone2 text-white font-bold transition-colors flex items-center gap-2 text-sm">
                        Next
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>

                <div class="text-sm font-semibold text-slate-300">
                    <span id="kca-slide-counter">Slide 1 of 33</span>
                </div>

                <div class="flex items-center gap-2">
                    <label for="kca-slide-select" class="text-xs text-slate-400">Jump to:</label>
                    <select id="kca-slide-select" onchange="jumpToSlide(this.value)" class="bg-slate-800 border border-slate-700 text-white rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-caci-tone2">
                        @for (int i = 1; i <= 33; i++)
                        {
                            <option value="@i">Slide @i</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <script>
            let currentSlide = 1;
            const totalSlides = 33;

            function updateSlide(index) {
                if (index < 1) index = 1;
                if (index > totalSlides) index = totalSlides;
                currentSlide = index;

                const pad = String(currentSlide).padStart(2, '0');
                const img = document.getElementById('kca-slide-img');
                const counter = document.getElementById('kca-slide-counter');
                const select = document.getElementById('kca-slide-select');

                if (img) img.src = `/images/foundations/lesson1/slide_${pad}.png`;
                if (counter) counter.innerText = `Slide ${currentSlide} of ${totalSlides}`;
                if (select) select.value = currentSlide;

                const prevBtn = document.getElementById('kca-prev-btn');
                const nextBtn = document.getElementById('kca-next-btn');
                if (prevBtn) prevBtn.disabled = (currentSlide === 1);
                if (nextBtn) nextBtn.disabled = (currentSlide === totalSlides);
            }

            function prevSlide() { updateSlide(currentSlide - 1); }
            function nextSlide() { updateSlide(currentSlide + 1); }
            function jumpToSlide(val) { updateSlide(parseInt(val, 10)); }
        </script>
    </section>

    <!-- Video Teaching Modules Section -->
    <section id="video-modules" class="space-y-10 pt-8 border-t border-slate-200">
        <div class="text-center max-w-3xl mx-auto">
            <span class="badge mb-2">Video Classrooms</span>
