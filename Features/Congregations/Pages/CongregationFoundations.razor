        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
            <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=12%20Foundations%20-%20Bottom%20CTA&topic=12%20Foundations%20Bible%20Study" class="btn-primary !bg-amber-400 !text-slate-900 hover:!bg-amber-300 font-bold px-8 py-4 text-base shadow-xl">
                Request a 12 Foundations Bible Study
            </a>
            <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=12%20Foundations%20-%20Ask%20a%20Question" class="btn-secondary !bg-white/10 !text-white !border-white/30 hover:!bg-white/20 font-semibold px-6 py-4 text-base">
                Ask a Question
            </a>
        </div>
