                                        {
                                            <span class="badge bg-purple-50 text-caci-purple border border-purple-200 font-semibold text-xs">
                                                Elder-Guided In-Person
                                            </span>
                                        }
                                        <span class="badge @(isOt ? "bg-caci-tone3 text-caci-minister" : "bg-purple-100 text-caci-purple") font-bold text-xs">
