                                        @if (!string.IsNullOrWhiteSpace(feastTag))
                                        {
                                            <span class="badge bg-amber-100 text-amber-900 border border-amber-200 text-xs font-semibold">
                                                @feastTag
                                            </span>
                                        }
                                        <span class="text-xs text-caci-gray font-medium">@f.ScriptureReference</span>
                                    </div>
                                    <h3 class="text-2xl md:text-3xl font-bold text-caci-blue">
                                        @f.Title
                                    </h3>
                                    <p class="mt-2 text-slate-700 text-base leading-relaxed max-w-3xl">
                                        @f.LeadSummary
                                    </p>
                                </div>
                            </div>

                            <!-- Right: Quick Action -->
                            <div class="shrink-0 flex md:flex-col gap-2 justify-end">
                                @if (f.SeriesOrder <= 3)
                                {
                                    <a href="https://caci.life/foundations/lesson/@f.SeriesOrder?ref=kca" target="_blank" rel="noopener" class="btn-primary !bg-[#C8102E] !text-white hover:!bg-red-700 text-sm py-2 px-4 whitespace-nowrap justify-center shadow">
                                        Take Lesson Online &nearr;
                                    </a>
                                }
                                <a href="@($"/congregation/{_profile.UrlSlug}/foundations/{f.Slug}")" class="btn-primary text-sm py-2 px-4 whitespace-nowrap justify-center">
                                    Full Study Syllabus →
                                </a>
                                <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=12%20Foundations%20-%20Lesson%20@f.SeriesOrder:%20@Uri.EscapeDataString(f.Title)&study=@Uri.EscapeDataString(f.Title)" class="btn-secondary text-sm py-2 px-4 whitespace-nowrap justify-center text-center">
                                    Request Local Study
                                </a>
                            </div>
                        </div>

                        <!-- In-Page Expandable Drawer for Extra Info -->
                        <details class="mt-6 pt-4 border-t border-slate-100 group">
                            <summary class="cursor-pointer list-none font-bold text-sm text-caci-minister hover:text-caci-tone2 flex items-center gap-2 select-none">
                                <svg class="w-4 h-4 text-caci-tone2 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                <span>Preview Foundation Details, Secrets &amp; Scriptures</span>
                            </summary>
                            
                            <div class="mt-5 grid md:grid-cols-2 gap-6 bg-slate-50 p-5 md:p-6 rounded-xl border border-slate-200/70 text-sm">
                                <!-- The Biblical Mystery -->
                                <div>
                                    <h5 class="font-bold text-caci-blue text-base flex items-center gap-2">
                                        <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                                        The Mystery Unlocked
                                    </h5>
                                    <p class="mt-2 text-slate-700 leading-relaxed">
                                        @hookInfo.Mystery
                                    </p>
                                </div>

                                <!-- What Church Tradition Misses -->
                                <div>
                                    <h5 class="font-bold text-caci-red text-base flex items-center gap-2">
                                        <svg class="w-4 h-4 text-caci-red" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                                        What Modern Churches Miss
                                    </h5>
                                    <p class="mt-2 text-slate-700 leading-relaxed">
                                        @hookInfo.TraditionVsTruth
                                    </p>
                                </div>

                                <!-- Key Verses -->
                                <div class="md:col-span-2 pt-3 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
