@page "/congregation/{Slug}/4keys"
@page "/congregation/{Slug}/4KeysInfo"
@page "/congregation/{Slug}/four-keys"
@layout CongregationLayout
@using CACI_Life.Core.Domain.Congregations
@inject ICongregationService CongregationService
@inject TenantContext TenantContext

<CongregationSeoHead Title="The 4 Keys of the Coming Kingdom | Apostolic Gospel & Law of God"
         Description="Discover the 4 Keys to understanding the Gospel of the Kingdom: The Coming of the Kingdom on earth, The Law of the Kingdom, The Culture of the Kingdom (Sabbath & Feasts), and The Royal Proclamation. Guided study with Kingdom Covenant Apostolic."
         Path="@($"/congregation/{_profile.UrlSlug}/4keys")"
         Faqs="@FourKeysFaqs" />

<!-- Hero Section -->
<section class="hero relative overflow-hidden py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
        <span class="inline-block py-1 px-4 rounded-full text-xs md:text-sm font-semibold tracking-wider uppercase bg-amber-400 text-slate-900 shadow-md mb-4">
            ~ Preaching the Kingdom ~ The Royal Proclamation
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
            The 4 Keys of the Coming Kingdom
        </h1>
        <p class="mt-4 text-xl md:text-2xl text-caci-tone3 font-medium italic">
            “Thy Kingdom come. Thy will be done in earth, as it is in heaven.”
        </p>
        <p class="text-sm font-semibold text-caci-tone3 uppercase tracking-widest mt-1">— Matthew 6:10</p>
        <p class="mt-6 text-base md:text-lg text-slate-100 max-w-3xl mx-auto leading-relaxed">
            The Holy Scriptures never declare eternity in heaven to be the reward of the saints. 
            Jesus / Yeshua came preaching the exact message the holy prophets foretold: 
            <strong>the restoration of God's sovereign Kingdom over all the earth.</strong>
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="#keys-grid" class="btn-primary !bg-amber-400 !text-slate-900 hover:!bg-amber-300 font-bold px-7 py-3 text-base shadow-lg">
                Explore the 4 Keys
            </a>
            <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=4%20Keys%20Hero&study=4-Keys-of-the-Kingdom" class="btn-primary font-bold px-6 py-3 text-base">
                Request Free Guided Study
            </a>
            <a href="@($"/congregation/{_profile.UrlSlug}/foundations")" class="btn-secondary !bg-white/10 !text-white !border-white/30 hover:!bg-white/20 font-semibold px-6 py-3 text-base">
                Explore the 12 Foundations &rarr;
            </a>
        </div>
    </div>
</section>

<!-- Main Container -->
<div class="max-w-6xl mx-auto px-4 py-12 md:py-16 space-y-16">

    <!-- The 4 Keys Cards Grid -->
    <section id="keys-grid" class="space-y-8 scroll-mt-20">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="badge mb-2">Apostolic Message</span>
            <h2 class="text-3xl md:text-5xl font-extrabold text-caci-blue">Unlocking the Gospel of the Kingdom</h2>
            <div class="section-rule mx-auto my-4"></div>
            <p class="text-slate-600 text-base md:text-lg">
                These four doctrinal keys unlock the unified message of Scripture from Genesis to Revelation without contradiction.
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            <!-- KEY 1 -->
            <article class="card p-6 md:p-8 border-t-4 border-t-[#C8102E] flex flex-col justify-between hover:shadow-xl transition-all">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="badge !bg-red-100 !text-[#C8102E] font-bold text-xs uppercase tracking-wider">Key 01</span>
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Restoration of the Earth</span>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-caci-blue mb-2">
                        The Coming of the Kingdom
                    </h3>
                    <p class="text-sm font-semibold text-caci-tone2 mb-4 italic">
                        "Blessed are the meek: for they shall inherit the earth." — Matthew 5:5
                    </p>
                    <p class="text-slate-700 text-sm md:text-base leading-relaxed mb-6">
                        From Genesis to Revelation, the Holy Scriptures consistently proclaim the physical renewal of creation and the literal earthly reign of the Messiah. 
                        Christ taught His disciples to pray <em>"Thy Kingdom come, Thy will be done in earth, as it is in heaven."</em> 
                        At the return of the Messiah, the righteous dead will be resurrected into incorruptible, glorified bodies to govern the nations alongside Christ in an everlasting, righteous dominion.
                    </p>

                    <!-- Scripture Anchors -->
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 mb-6 space-y-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-caci-minister block mb-1">Key Scriptural Anchors</span>
                        <p class="text-xs text-slate-700"><strong>Matthew 5:5</strong> — Blessed are the meek: for they shall inherit the earth.</p>
                        <p class="text-xs text-slate-700"><strong>Revelation 5:10</strong> — And hast made us unto our God kings and priests: and we shall reign on the earth.</p>
                        <p class="text-xs text-slate-700"><strong>Daniel 7:27</strong> — And the kingdom and dominion, and the greatness of the kingdom under the whole heaven, shall be given to the people of the saints of the most High.</p>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                    <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=4%20Keys%20-%20Key%201&study=The-Coming-of-the-Kingdom" class="btn-primary text-xs py-2 px-4">
                        Request Guided Study
                    </a>
                    <a href="/what-we-believe#commission" class="text-xs font-bold text-caci-minister hover:underline">
                        Read Doctrinal Foundation &rarr;
                    </a>
                </div>
            </article>

            <!-- KEY 2 -->
            <article class="card p-6 md:p-8 border-t-4 border-t-caci-blue flex flex-col justify-between hover:shadow-xl transition-all">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="badge !bg-blue-100 !text-caci-blue font-bold text-xs uppercase tracking-wider">Key 02</span>
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Torah Written on Hearts</span>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-caci-blue mb-2">
                        The Law of the Kingdom
                    </h3>
                    <p class="text-sm font-semibold text-caci-tone2 mb-4 italic">
                        "I will put my law in their inward parts, and write it in their hearts." — Jeremiah 31:33
                    </p>
                    <p class="text-slate-700 text-sm md:text-base leading-relaxed mb-6">
                        Modern religious tradition often paints Jesus as a lawless King who came to abolish God's holy standards. 
                        In contrast, the New Covenant explicitly fulfills Jeremiah's prophecy: the Law written into the minds and hearts of believers by the Holy Spirit. 
                        Messiah did not come to destroy the Law or the Prophets, but to demonstrate their true spiritual intent. 
                        The Ten Commandments, including the 7th-day Sabbath, remain the eternal standard of Kingdom righteousness.
                    </p>

                    <!-- Scripture Anchors -->
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 mb-6 space-y-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-caci-minister block mb-1">Key Scriptural Anchors</span>
                        <p class="text-xs text-slate-700"><strong>Jeremiah 31:33</strong> — I will put my law in their inward parts, and write it in their hearts; and will be their God, and they shall be my people.</p>
                        <p class="text-xs text-slate-700"><strong>Matthew 5:17–19</strong> — Think not that I am come to destroy the law, or the prophets: I am not come to destroy, but to fulfil.</p>
                        <p class="text-xs text-slate-700"><strong>Isaiah 2:3</strong> — For out of Zion shall go forth the law, and the word of the LORD from Jerusalem.</p>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                    <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=4%20Keys%20-%20Key%202&study=The-Law-of-the-Kingdom" class="btn-primary text-xs py-2 px-4">
                        Request Guided Study
                    </a>
                    <a href="@($"/congregation/{_profile.UrlSlug}/sabbath")" class="text-xs font-bold text-caci-minister hover:underline">
                        Why The Sabbath? &rarr;
                    </a>
                </div>
            </article>

            <!-- KEY 3 -->
            <article class="card p-6 md:p-8 border-t-4 border-t-caci-purple flex flex-col justify-between hover:shadow-xl transition-all">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="badge !bg-purple-100 !text-caci-purple font-bold text-xs uppercase tracking-wider">Key 03</span>
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Covenant Lifestyle & Feasts</span>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-caci-blue mb-2">
                        The Culture of the Kingdom
                    </h3>
                    <p class="text-sm font-semibold text-caci-tone2 mb-4 italic">
                        "Ye are a chosen generation, a royal priesthood, an holy nation." — 1 Peter 2:9
                    </p>
                    <p class="text-slate-700 text-sm md:text-base leading-relaxed mb-6">
                        Kingdom citizenship produces an identifiable, sanctified way of life distinct from worldly culture and pagan syncretism. 
                        Believers are called out to honor the Lord's appointed times (moedim)—such as the 7th-day Sabbath, Passover, Pentecost, and Tabernacles—and to maintain holiness in speech, dietary discernment, and family structure. 
                        As a royal priesthood, our households function as active embassies representing King Jesus.
                    </p>

                    <!-- Scripture Anchors -->
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 mb-6 space-y-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-caci-minister block mb-1">Key Scriptural Anchors</span>
                        <p class="text-xs text-slate-700"><strong>Leviticus 23:2</strong> — Concerning the feasts of the LORD, which ye shall proclaim to be holy convocations, even these are my feasts.</p>
                        <p class="text-xs text-slate-700"><strong>1 Peter 2:9</strong> — But ye are a chosen generation, a royal priesthood, an holy nation, a peculiar people.</p>
                        <p class="text-xs text-slate-700"><strong>Romans 12:2</strong> — And be not conformed to this world: but be ye transformed by the renewing of your mind.</p>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                    <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=4%20Keys%20-%20Key%203&study=The-Culture-of-the-Kingdom" class="btn-primary text-xs py-2 px-4">
                        Request Guided Study
                    </a>
                    <a href="/feasts" class="text-xs font-bold text-caci-minister hover:underline">
                        Explore Biblical Feasts &rarr;
                    </a>
                </div>
            </article>

            <!-- KEY 4 -->
            <article class="card p-6 md:p-8 border-t-4 border-t-amber-500 flex flex-col justify-between hover:shadow-xl transition-all">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="badge !bg-amber-100 !text-amber-900 font-bold text-xs uppercase tracking-wider">Key 04</span>
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">The Good News of His Reign</span>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-caci-blue mb-2">
                        The Gospel of the Kingdom
                    </h3>
                    <p class="text-sm font-semibold text-caci-tone2 mb-4 italic">
                        "Jesus came into Galilee, preaching the gospel of the kingdom of God." — Mark 1:14
                    </p>
                    <p class="text-slate-700 text-sm md:text-base leading-relaxed mb-6">
                        The Gospel is far more than an individual escape ticket to the clouds. 
                        It is the royal, historic announcement that God's sovereign King has arrived to break the powers of darkness, redeem fallen humanity through His shed blood, and re-establish the government of God upon earth. 
                        Repentance, baptism in the Name of Jesus Christ for remission of sins, and the gift of the Holy Ghost (Acts 2:38) mark our allegiance to His crown and citizenship in His realm.
                    </p>

                    <!-- Scripture Anchors -->
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 mb-6 space-y-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-caci-minister block mb-1">Key Scriptural Anchors</span>
                        <p class="text-xs text-slate-700"><strong>Mark 1:14–15</strong> — The time is fulfilled, and the kingdom of God is at hand: repent ye, and believe the gospel.</p>
                        <p class="text-xs text-slate-700"><strong>Matthew 24:14</strong> — And this gospel of the kingdom shall be preached in all the world for a witness unto all nations; and then shall the end come.</p>
                        <p class="text-xs text-slate-700"><strong>Acts 2:38</strong> — Repent, and be baptized every one of you in the name of Jesus Christ for the remission of sins, and ye shall receive the gift of the Holy Ghost.</p>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                    <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=4%20Keys%20-%20Key%204&study=The-Gospel-of-the-Kingdom" class="btn-primary text-xs py-2 px-4">
                        Request Guided Study
                    </a>
                    <a href="/what-we-believe#commission" class="text-xs font-bold text-caci-minister hover:underline">
                        Acts 2:38 Standard &rarr;
                    </a>
                </div>
            </article>
        </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="max-w-4xl mx-auto space-y-6 pt-10 border-t border-slate-200">
        <div class="text-center mb-8">
            <span class="badge mb-2">Clarity & Understanding</span>
            <h2 class="text-3xl font-bold text-caci-blue">Frequently Asked Questions</h2>
            <div class="section-rule mx-auto my-3"></div>
        </div>

        <div class="space-y-4">
            <details class="card p-5 group open:border-caci-blue transition-all cursor-pointer">
                <summary class="font-bold text-caci-blue text-base sm:text-lg flex items-center justify-between list-none select-none">
                    <span>What are the 4 Keys of the Kingdom?</span>
                    <svg class="w-5 h-5 text-caci-tone2 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="mt-3 pt-3 border-t border-slate-100 text-sm text-slate-700 leading-relaxed">
                    The 4 Keys represent foundational biblical doctrines restored in Apostolic understanding: The Coming Kingdom (earthly resurrection and reign), The Law of the Kingdom (Torah written on hearts), The Culture of the Kingdom (biblical feasts and holy living), and The Gospel of the Kingdom (the royal proclamation of Messiah's sovereign government).
                </div>
            </details>

            <details class="card p-5 group open:border-caci-blue transition-all cursor-pointer">
                <summary class="font-bold text-caci-blue text-base sm:text-lg flex items-center justify-between list-none select-none">
                    <span>Does Scripture teach believers spend eternity in heaven?</span>
                    <svg class="w-5 h-5 text-caci-tone2 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="mt-3 pt-3 border-t border-slate-100 text-sm text-slate-700 leading-relaxed">
                    No. From the Genesis creation mandate through Revelation 21-22, God's ultimate plan is the redemption of this physical earth. Christ taught that "the meek shall inherit the earth" (Matt 5:5), and Revelation 5:10 confirms the saints will "reign on the earth." Heaven is the present throne of God, but the New Jerusalem descends to earth.
                </div>
            </details>

            <details class="card p-5 group open:border-caci-blue transition-all cursor-pointer">
                <summary class="font-bold text-caci-blue text-base sm:text-lg flex items-center justify-between list-none select-none">
                    <span>How does the 7th-day Sabbath relate to the 4 Keys?</span>
                    <svg class="w-5 h-5 text-caci-tone2 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="mt-3 pt-3 border-t border-slate-100 text-sm text-slate-700 leading-relaxed">
                    The Sabbath is part of both Key 2 (The Law of the Kingdom) and Key 3 (The Culture of the Kingdom). It was established at Creation (Gen 2:1-3), codified in the 10 Commandments, observed by Messiah and the Apostles, and will be observed by all flesh in the New Heavens and New Earth (Isaiah 66:22-23).
                </div>
            </details>

            <details class="card p-5 group open:border-caci-blue transition-all cursor-pointer">
                <summary class="font-bold text-caci-blue text-base sm:text-lg flex items-center justify-between list-none select-none">
                    <span>How do I participate in a guided 4 Keys Bible study?</span>
                    <svg class="w-5 h-5 text-caci-tone2 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="mt-3 pt-3 border-t border-slate-100 text-sm text-slate-700 leading-relaxed">
                    Click the "Request Guided Study" button on any key card or visit our Connect page. An elder from @_profile.CongregationName will reach out to schedule an in-home study or online session walking through the scriptures with you verse by verse.
                </div>
            </details>
        </div>
    </section>

    <!-- Bottom Callout -->
    <section class="rounded-3xl bg-gradient-to-br from-caci-minister via-caci-blue to-caci-purple p-8 md:p-14 text-white shadow-2xl text-center space-y-6">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-amber-400 text-slate-900 shadow">
            Free Personal Discipleship
        </span>
        <h2 class="text-3xl md:text-5xl font-extrabold text-white leading-tight">
            Ready to Study the 4 Keys With Us?
        </h2>
        <p class="text-slate-200 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
            The ministry and fellowship of @_profile.CongregationName are here to study with you one-on-one or in an assembly group.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
            <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=4%20Keys%20Bottom%20CTA&study=4-Keys-of-the-Kingdom" class="btn-primary !bg-amber-400 !text-slate-900 hover:!bg-amber-300 font-bold px-8 py-4 text-base shadow-xl">
                Request a 4 Keys Bible Study
            </a>
            <a href="@($"/congregation/{_profile.UrlSlug}/foundations")" class="btn-secondary !bg-white/10 !text-white !border-white/30 hover:!bg-white/20 font-semibold px-6 py-4 text-base">
                Explore the 12 Foundations &rarr;
            </a>
        </div>
    </section>

</div>

@code {
    private CongregationProfile _profile = new();

    [Parameter] public string Slug { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            TenantContext.SetSlug(Slug);
        }
        _profile = await CongregationService.GetCurrentAsync();
    }

    private static readonly IReadOnlyList<CongregationSeoHead.FaqItem> FourKeysFaqs = new CongregationSeoHead.FaqItem[]
    {
        new(
            "What are the 4 Keys of the Kingdom?",
            "The 4 Keys represent foundational biblical doctrines restored in Apostolic understanding: The Coming Kingdom (earthly resurrection and reign), The Law of the Kingdom (Torah written on hearts), The Culture of the Kingdom (biblical feasts and holy living), and The Gospel of the Kingdom (the royal proclamation of Messiah's sovereign government)."
        ),
        new(
            "Does Scripture teach believers spend eternity in heaven?",
            "No. From the Genesis creation mandate through Revelation 21-22, God's ultimate plan is the redemption of this physical earth. Christ taught that 'the meek shall inherit the earth' (Matt 5:5), and Revelation 5:10 confirms the saints will 'reign on the earth.' Heaven is the present throne of God, but the New Jerusalem descends to earth."
        ),
        new(
            "How does the 7th-day Sabbath relate to the 4 Keys?",
            "The Sabbath is part of both Key 2 (The Law of the Kingdom) and Key 3 (The Culture of the Kingdom). It was established at Creation (Gen 2:1-3), codified in the 10 Commandments, observed by Messiah and the Apostles, and will be observed by all flesh in the New Heavens and New Earth (Isaiah 66:22-23)."
        ),
        new(
            "How do I participate in a guided 4 Keys Bible study?",
            "Click the 'Request Guided Study' button on any key card or visit our Connect page. An elder from our ministry will reach out to schedule an in-home study or online session walking through the scriptures with you verse by verse."
        )
    };
}



