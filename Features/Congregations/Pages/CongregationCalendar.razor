@page "/congregation/{Slug}/calendar"
@page "/congregation/{Slug}/events"
@layout CongregationLayout
@using CACI_Life.Core.Domain.Congregations
@inject ICongregationService CongregationService
@inject TenantContext TenantContext

<CongregationSeoHead Title="@($"{_profile.CongregationName} & CACI Corporate Calendar")"
         Description="Stay up to date with national traveling feasts, council meetings, and corporate convocations across Covenant Apostolic Congregations International."
         Path="@($"/congregation/{_profile.UrlSlug}/calendar")" />

<section class="hero">
    <div class="max-w-4xl mx-auto px-4 py-16 text-center">
        <span class="badge mb-3" style="background: rgba(255,255,255,0.2); color: #fff;">@_profile.CongregationName &amp; CACI Fellowship</span>
        <h1 class="text-4xl md:text-5xl font-bold">Events &amp; Community Calendar</h1>
        <p class="mt-4 text-lg text-slate-100">Stay up to date with national traveling feasts, holy convocations, and corporate gatherings.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a class="btn-primary btn-red" href="https://cacievents.com" target="_blank" rel="noopener">
                Register for Current Event &nearr;
            </a>
            <a class="btn-hero-secondary" href="@($"/congregation/{_profile.UrlSlug}/feasts")">
                Explore Biblical Feasts (Moedim) &rarr;
            </a>
        </div>
    </div>
</section>

<section class="max-w-5xl mx-auto px-4 py-12">
    <!-- Quick Registration Callout -->
    <div class="card p-6 md:p-8 mb-10 bg-gradient-to-r from-caci-minister via-caci-blue to-caci-purple text-white shadow-xl">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="max-w-2xl">
                <span class="badge mb-2" style="background: rgba(255,255,255,0.2); color: #fff;">National Convocations</span>
                <h2 class="text-2xl md:text-3xl font-bold text-white">Corporate Traveling Feasts & Registration</h2>
                <p class="mt-2 text-slate-100 text-sm md:text-base leading-relaxed">
                    Covenant Apostolic Congregations International coordinates corporate traveling convocations for the annual appointed times. Register for upcoming corporate feasts, view host accommodations, and review assembly itineraries.
                </p>
            </div>
            <div class="shrink-0">
                <a class="btn-primary whitespace-nowrap" style="background: var(--caci-red); color: #fff !important;" href="https://cacievents.com" target="_blank" rel="noopener">
                    <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    Register on CACI Events &nearr;
                </a>
            </div>
        </div>
    </div>

    <!-- Community Calendar Embed Card -->
    <div class="card p-6 md:p-10 mb-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200 pb-6 mb-8">
            <div>
                <span class="badge mb-2">Live Schedule</span>
                <h2 class="text-3xl md:text-4xl font-bold text-caci-blue">CACI Community Calendar</h2>
                <p class="mt-2 text-slate-600">
                    Shared Google Calendar synchronized with corporate headquarters and participating congregations.
                </p>
            </div>
            <div class="shrink-0 flex flex-wrap gap-2">
                <a href="https://calendar.google.com/calendar/embed?src=c_3eab6dfa926464d4fbd097be71f7474f10da71ed771c9b2f3d290f18f7362ba1%40group.calendar.google.com&ctz=America%2FChicago&wkst=1"
                   target="_blank" rel="noopener"
                   class="btn-secondary text-sm">
                    Open in Google Calendar &nearr;
                </a>
                <a href="https://cacievents.com"
                   target="_blank" rel="noopener"
                   class="btn-primary text-sm" style="background: var(--caci-red);">
                    Event Registration &nearr;
                </a>
            </div>
        </div>

        <!-- Google Calendar Responsive Embed -->
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-white shadow-inner">
            <div class="hidden md:block">
                <iframe src="https://calendar.google.com/calendar/embed?src=c_3eab6dfa926464d4fbd097be71f7474f10da71ed771c9b2f3d290f18f7362ba1%40group.calendar.google.com&ctz=America%2FChicago&wkst=1"
                        style="border: 0" width="100%" height="650" frameborder="0" scrolling="no" title="CACI Corporate Calendar"></iframe>
            </div>
            <div class="block md:hidden">
                <iframe src="https://calendar.google.com/calendar/embed?src=c_3eab6dfa926464d4fbd097be71f7474f10da71ed771c9b2f3d290f18f7362ba1%40group.calendar.google.com&ctz=America%2FChicago&wkst=1&mode=AGENDA"
                        style="border: 0" width="100%" height="500" frameborder="0" scrolling="no" title="CACI Corporate Calendar Agenda"></iframe>
            </div>
        </div>
    </div>

    <!-- 2026 At-A-Glance Card -->
    <div class="card p-6 md:p-10 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-caci-blue mb-2">2026 Calendar At A Glance</h2>
        <p class="text-slate-600 max-w-2xl mx-auto mb-6">
            Official ecclesiastical schedule for the annual biblical festivals and convocations.
        </p>
        <div class="max-w-3xl mx-auto rounded-xl overflow-hidden border border-slate-200 shadow-md bg-white p-2">
            <img src="/images/2026_Calendar_Glance.png" alt="CACI 2026 Calendar At A Glance" class="w-full h-auto rounded-lg mx-auto" loading="lazy" />
        </div>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
            <a href="/pdfs/2026_Calendar_Glance.pdf" target="_blank" rel="noopener" class="btn-secondary">
                <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Download 2026 Calendar (PDF)
            </a>
            <a href="https://cacievents.com" target="_blank" rel="noopener" class="btn-primary btn-red">
                Register for Traveling Feasts
            </a>
        </div>
    </div>
</section>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private CongregationProfile _profile = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            TenantContext.SetSlug(Slug);
        }
        _profile = await CongregationService.GetCurrentAsync();
    }
}

