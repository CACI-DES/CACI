@page "/congregation/{Slug}/teachings"
@page "/congregation/{Slug}/studies"
@layout CongregationLayout
@using CACI_Life.Core.Domain.Congregations
@using CACI_Life.Features.Congregations.Queries
@inject ICongregationService CongregationService
@inject TenantContext TenantContext
@inject GetStudiesQueries StudiesQueries

<CongregationSeoHead Title="@($"Apostolic Teachings & Biblical Expositions | {_profile.CongregationName}")"
         Description="Explore biblical teachings and expository outlines on the Sabbath, the Biblical Feasts of Leviticus 23, Apostolic doctrine, and whole-Bible prophetic truth."
         Path="@($"/congregation/{_profile.UrlSlug}/teachings")" />

<!-- 1. HERO SECTION -->
<section class="hero relative overflow-hidden py-16 md:py-24 text-center text-white">
    <div class="max-w-5xl mx-auto px-4 relative z-10">
        <span class="badge uppercase tracking-widest mb-4 bg-white/20 text-white border border-white/30 text-xs py-1.5 px-4 rounded-full">
            Apostolic Teachings &amp; Prophetic Expositions
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight mb-4">
            Apostolic Teachings
        </h1>
        <p class="text-xl md:text-2xl text-caci-tone3 font-head italic mb-4">
            &ldquo;Preach the word; be instant in season, out of season; reprove, rebuke, exhort with all longsuffering and doctrine.&rdquo;
        </p>
        <p class="text-xs font-semibold text-amber-300 uppercase tracking-widest mb-6">&mdash; 2 Timothy 4:2 (KJV)</p>
        <p class="text-base sm:text-lg text-slate-100 max-w-3xl mx-auto leading-relaxed mb-8">
            In-depth biblical expositions and scripture outlines exploring the Sabbath, the Biblical Feasts of Leviticus 23, 
            the restoration of the House of Israel, and the whole counsel of God.
        </p>

        <!-- Category Filters -->
        @if (_categories.Count > 1)
        {
            <div class="flex flex-wrap justify-center gap-2 text-xs md:text-sm">
                <button type="button" 
                        @onclick='() => SetCategory("All")' 
                        class="px-4 py-2 rounded-full font-semibold transition cursor-pointer @(_selectedCategory == "All" ? "bg-amber-400 text-slate-900 border border-amber-300 shadow" : "bg-white/10 hover:bg-white/20 text-white border border-white/20")">
                    All Teachings (@_teachings.Count)
                </button>
                @foreach (var cat in _categories)
                {
                    var count = _teachings.Count(t => string.Equals(t.Category, cat, StringComparison.OrdinalIgnoreCase));
                    <button type="button" 
                            @onclick="() => SetCategory(cat)" 
                            class="px-4 py-2 rounded-full font-semibold transition cursor-pointer @(_selectedCategory == cat ? "bg-amber-400 text-slate-900 border border-amber-300 shadow" : "bg-white/10 hover:bg-white/20 text-white border border-white/20")">
                        @cat (@count)
                    </button>
                }
            </div>
        }
    </div>
</section>

<div class="max-w-6xl mx-auto px-4 py-12 md:py-16 space-y-16">

    <!-- TEACHINGS GRID -->
    <section>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
            <div>
                <h2 class="text-2xl md:text-3xl font-extrabold text-caci-blue">
                    @(_selectedCategory == "All" ? "All Scripture Teachings" : $"{_selectedCategory} Teachings")
                </h2>
                <p class="text-sm text-slate-600 mt-1">Showing @FilteredTeachings.Count teaching@(FilteredTeachings.Count == 1 ? "" : "s")</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="@($"/congregation/{_profile.UrlSlug}/bible-studies")" class="btn-secondary text-xs py-2 px-4">
                    View Bible Studies Curriculum &rarr;
                </a>
            </div>
        </div>

        @if (FilteredTeachings.Count == 0)
        {
            <div class="card p-12 text-center max-w-xl mx-auto text-slate-600 my-8">
                <p class="text-base font-semibold text-caci-blue">No teachings found in this category.</p>
                <p class="text-sm mt-2">Try selecting another topic or browse all available teachings.</p>
                <button type="button" @onclick='() => SetCategory("All")' class="btn-primary text-xs py-2.5 px-4 mt-4 inline-block">
                    View All Teachings
                </button>
            </div>
        }
        else
        {
            <div class="grid gap-6 md:grid-cols-2 mt-8">
                @foreach (var s in FilteredTeachings)
                {
                    <article class="card p-6 flex flex-col justify-between hover:shadow-xl transition-all duration-200 border border-slate-200 hover:border-caci-blue group">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <span class="badge uppercase tracking-wider text-[11px] @GetBadgeClass(s.Category)">@s.Category</span>
                                <span class="text-xs text-caci-gray">@s.PublishedUtc.ToString("MMMM d, yyyy")</span>
                            </div>
                            <h3 class="text-xl font-bold text-caci-blue group-hover:text-caci-tone2 transition-colors mt-2">
                                <a href="@($"/congregation/{_profile.UrlSlug}/teachings/{s.Slug}")" class="no-underline text-inherit">@s.Title</a>
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(s.ScriptureReference))
                            {
                                <p class="text-xs font-semibold text-amber-700 mt-1 flex items-center gap-1">
                                    <span>ðŸ“–</span> @s.ScriptureReference
                                </p>
                            }
                            <p class="text-sm text-slate-600 mt-3 leading-relaxed">@s.LeadSummary</p>
                        </div>
                        <div class="pt-4 mt-6 border-t border-slate-100 flex items-center justify-between">
                            <a href="@($"/congregation/{_profile.UrlSlug}/teachings/{s.Slug}")" class="text-xs font-bold text-caci-blue group-hover:text-caci-minister flex items-center gap-1 no-underline">
                                Read Complete Teaching <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
                            </a>
                            <span class="text-[11px] text-slate-600">Free Expository Article</span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <!-- CROSS-LINK TO BIBLE STUDIES CURRICULUM -->
    <section class="card p-6 md:p-8 bg-gradient-to-br from-slate-50 via-white to-amber-50/40 border border-slate-200 shadow-sm">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
            <div class="space-y-2">
                <span class="badge uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-200">
                    Discipleship Curriculum
                </span>
                <h3 class="text-2xl font-bold text-caci-blue">Looking for Our Structured Bible Studies?</h3>
                <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
                    Explore the 12 Foundations Bible Study timeline, unlock the 4 Keys of the Kingdom (Our Message), 
                    and build upon the 4 Apostolic Pillars of Acts 2:42 (Our Mission).
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-3 shrink-0">
                <a href="@($"/congregation/{_profile.UrlSlug}/bible-studies")" class="btn-primary font-bold text-xs py-3 px-6 shadow">
                    Go to Bible Studies Hub &rarr;
                </a>
                <a href="@($"/congregation/{_profile.UrlSlug}/4keys")" class="btn-secondary text-xs py-3 px-5">
                    Explore The 4 Keys
                </a>
            </div>
        </div>
    </section>

    <!-- GUIDED STUDY INTAKE BANNER -->
    <section class="scripture-card text-center p-8 md:p-12">
        <span class="label">PERSONAL &amp; GROUP DISCIPLESHIP</span>
        <h3 class="text-2xl md:text-4xl font-bold font-head text-white mt-2 mb-4">Questions About a Teaching?</h3>
        <p class="text-slate-200 max-w-2xl mx-auto text-sm md:text-base mb-6 leading-relaxed">
            Whether in-home across @_profile.RegionDescription or online worldwide via video call, our elders provide personalized, peaceful dialogue and guided studies free of charge.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="@($"/congregation/{_profile.UrlSlug}/connect?topic=Teachings")" class="btn-primary !bg-[#C8102E] !text-white hover:!bg-red-700 font-bold px-8 py-3.5 shadow-lg text-base">
                Connect With An Elder
            </a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe")" class="btn-secondary px-6 py-3.5 text-base">
                Explore What We Believe
            </a>
        </div>
    </section>

</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private CongregationProfile _profile = new();
    private IReadOnlyList<StudySummaryDto> _teachings = [];
    private List<string> _categories = [];
    private string _selectedCategory = "All";

    private IReadOnlyList<StudySummaryDto> FilteredTeachings =>
        _selectedCategory == "All"
            ? _teachings
            : _teachings.Where(t => string.Equals(t.Category, _selectedCategory, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            TenantContext.SetSlug(Slug);
        }
        _profile = await CongregationService.GetCurrentAsync();
        var allStudies = await StudiesQueries.ListAsync();
        _teachings = allStudies
            .Where(x => !string.Equals(x.Category, "Foundations", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.PublishedUtc)
            .ToList();

        _categories = _teachings
            .Select(t => t.Category)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c)
            .ToList();
    }

    private void SetCategory(string category)
    {
        _selectedCategory = category;
    }

    private static string GetBadgeClass(string? category) => category?.ToLowerInvariant() switch
    {
        "sabbath" => "bg-blue-100 text-blue-900 border-blue-200",
        "feasts" => "bg-purple-100 text-purple-900 border-purple-200",
        "prophecy" => "bg-amber-100 text-amber-900 border-amber-200",
        "covenants" => "bg-emerald-100 text-emerald-900 border-emerald-200",
        _ => "bg-slate-100 text-slate-800 border-slate-200"
    };
}

