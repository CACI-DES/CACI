@page "/congregation/{Slug}/sabbath"
@layout CongregationLayout
@using CACI_Life.Core.Domain.Congregations
@inject ICongregationService CongregationService
@inject TenantContext TenantContext

<CongregationSeoHead Title="Why The Sabbath? | Seventh Day Biblical Sabbath & Church History"
         Description="@($"Comprehensive biblical and historical evidence for the Seventh-Day Sabbath (Saturday). From Genesis creation to the Apostles and the New Earth. Apostolic Sabbath fellowship {_profile.RegionDescription}.")"
         Path="@($"/congregation/{_profile.UrlSlug}/sabbath")"
         Faqs="@SabbathFaqs" />

<!-- HERO SECTION -->
<section class="hero py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 text-center">
        <span class="badge uppercase tracking-wider mb-4">Biblical Foundations &amp; Church History</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6">Why The Sabbath?</h1>
        <div class="max-w-3xl mx-auto">
            <p class="text-xl md:text-2xl text-slate-100 font-head italic mb-4">
                What does the Bible and history say about the Seventh Day Sabbath?
            </p>
            <p class="text-sm text-slate-200 leading-relaxed">
                All Hebrew and Greek definitions are cited from Strong's Concordance, Brown-Driver-Briggs Hebrew &amp; English Lexicon, Thayer's Greek-English Lexicon, and Webster's 1611 KJV Dictionary.
            </p>
        </div>

        <!-- Jump Navigation Pills -->
        <nav aria-label="Sabbath Topics" class="mt-10 flex flex-wrap justify-center gap-2 md:gap-3 text-xs md:text-sm">
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")creation" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">1. Creation Pattern</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")obedience" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">2. Proving Obedience</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")commandment" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">3. The 4th Commandment</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")sign-covenant" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">4. Perpetual Sign</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")feasts" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">5. Feasts of the LORD</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")all-nations" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">6. For All Nations</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")future-kingdom" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">7. Millennial Kingdom</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")yeshua" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">8. Jesus &amp; The Sabbath</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")apostles" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">9. Apostles in Acts</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")first-day" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">10. "First Day" Texts</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")paul-letters" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">11. Romans, Galatians, Colossians</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")hebrews" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">12. Hebrews 4 Rest</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")history" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">13. Constantine &amp; Rome</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")warnings" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">14. Prophetic Warnings</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")practical-guide" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">Practical Guide</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/sabbath#")what-is-truth" class="px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">15. What Is Truth?</a>
        </nav>
    </div>
</section>

<!-- MAIN CONTENT CONTAINER -->
<div class="max-w-5xl mx-auto px-4 py-12 space-y-16">

    <!-- 1. THE FIRST SABBATH -->
    <section id="creation" class="card p-6 md:p-8 scroll-mt-24 border-l-8 border-l-caci-blue">
        <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="badge mb-1">Creation Week</span>
            <h2 class="text-2xl md:text-3xl font-bold">1. The First Sabbath</h2>
        </div>

        <div class="bg-blue-50/50 p-5 rounded-lg border border-blue-100 mb-6">
            <span class="font-bold text-caci-minister font-head text-lg block mb-1">
                <a href="https://www.blueletterbible.org/kjv/gen/2/2" target="_blank" rel="noopener noreferrer">Genesis 2:2&ndash;3 (KJV) &nearr;</a>
            </span>
            <blockquote class="scripture-quote text-slate-800 text-sm md:text-base leading-relaxed">
                And on the <strong>seventh day</strong> God ended his <strong>work</strong> which he had made; and he <strong>rested</strong> on the seventh day from all his <strong>work</strong> which he had made.
                <strong class="font-bold text-caci-blue">3</strong> And God <strong>blessed</strong> the seventh day, and <strong>sanctified</strong> it: because that in it he had <strong>rested</strong> from all his <strong>work</strong> which God created and made.
            </blockquote>
        </div>

        <!-- Hebrew Lexicon Cards -->
        <h3 class="text-xs font-bold text-caci-gray uppercase tracking-wider mb-3">Original Hebrew Word Studies</h3>
        <div class="grid md:grid-cols-3 gap-3 mb-6">
            <div class="bg-parchment p-3.5 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Seventh &mdash; H7637 שְׁבִיעִי (shbi'iy)</p>
                <p class="text-slate-700 mt-1">Seventh (time); the 7th ordinal.</p>
            </div>
            <div class="bg-parchment p-3.5 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Day &mdash; H3117 יוֹם (yowm)</p>
                <p class="text-slate-700 mt-1">A day (from sunset to sunset or sunrise to sunset); an appointed period.</p>
            </div>
            <div class="bg-parchment p-3.5 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Work &mdash; H4399 מְלָאכָה (mla'kah)</p>
                <p class="text-slate-700 mt-1">Deputyship, ministry, employment, occupation, regular labor.</p>
            </div>
            <div class="bg-parchment p-3.5 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Rested &mdash; H7673 שָׁבַת (shabath)</p>
                <p class="text-slate-700 mt-1">To repose, desist from exertion, cease, celebrate, keep sabbath.</p>
            </div>
            <div class="bg-parchment p-3.5 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Blessed &mdash; H1288 בָּרַךְ (barak)</p>
                <p class="text-slate-700 mt-1">To pronounce beneficial, endue with special divine favor.</p>
            </div>
            <div class="bg-parchment p-3.5 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Sanctified &mdash; H6942 קָדַשׁ (qadash)</p>
                <p class="text-slate-700 mt-1">To consecrate, dedicate, hallow, set apart as sacred and distinct.</p>
            </div>
        </div>

        <div class="bg-slate-50 border-t-2 border-caci-blue p-4 rounded-b-lg text-sm text-slate-800 leading-relaxed">
            <strong class="text-caci-minister">Key Understanding:</strong>
            During the week of creation, God ended His labors on the seventh day; He rested from all of His labors. He set the seventh day apart from the rest of the days and He blessed it. God ceased from creating and rested. He set the pattern for all of mankind.
        </div>
    </section>

    <!-- 2. THE SABBATH WILL PROVE OBEDIENCE -->
    <section id="obedience" class="card p-6 md:p-8 scroll-mt-24 border-l-8 border-l-caci-purple">
        <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="badge mb-1">Wilderness of Sin (Before Sinai)</span>
            <h2 class="text-2xl md:text-3xl font-bold">2. The Sabbath Will Prove Obedience</h2>
        </div>

        <div class="bg-purple-50/50 p-5 rounded-lg border border-purple-100 mb-6">
            <span class="font-bold text-caci-minister font-head text-lg block mb-1">
                <a href="https://www.blueletterbible.org/kjv/exo/16/4" target="_blank" rel="noopener noreferrer">Exodus 16:4&ndash;5, 21&ndash;30 (KJV) &nearr;</a>
            </span>
            <blockquote class="scripture-quote text-slate-800 text-xs md:text-sm leading-relaxed space-y-2">
                <p>
                    Then said the LORD unto Moses, Behold, I will rain bread from heaven for you; and the people shall go out and <strong>gather</strong> a certain rate every day, <strong class="text-caci-minister">that I may prove them, whether they will walk in my law, or no.</strong>
                    <strong>5</strong> And it shall come to pass, that on the sixth day they shall prepare that which they bring in; and it shall be twice as much as they gather daily...
                </p>
                <p>
                    <strong>23</strong> And he said unto them, This is that which the LORD hath said, <strong class="text-caci-purple">To morrow is the rest of the holy sabbath unto the LORD</strong>...
                    <strong>26</strong> Six days ye shall gather it; but on the seventh day, which is the sabbath, in it there shall be none.
                    <strong>27</strong> And it came to pass, that there went out some of the people on the seventh day for to gather, and they found none.
                    <strong>28</strong> And the LORD said unto Moses, <strong class="text-caci-red">How long refuse ye to keep my commandments and my laws?</strong>
                    <strong>29</strong> See, for that the LORD hath given you the sabbath, therefore he giveth you on the sixth day the bread of two days...
                    <strong>30</strong> So the people rested on the seventh day.
                </p>
            </blockquote>
        </div>

        <h3 class="text-xs font-bold text-caci-gray uppercase tracking-wider mb-3">Key Lexicon Terms</h3>
        <div class="grid md:grid-cols-4 gap-3 mb-6">
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Law &mdash; H8451 תּוֹרָה (Torah)</p>
                <p class="text-slate-700 mt-1">Divine direction, instruction, legal code, body of prophetic teaching.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Sabbath &mdash; H7676 שַׁבָּת (Shabbath)</p>
                <p class="text-slate-700 mt-1">Intermission, cessation, the seventh day of weekly rest.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Rest &mdash; H7677 שַׁבָּתוֹן (Shabbathown)</p>
                <p class="text-slate-700 mt-1">A sabbatism, sacred rest, or special holiday unto God.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Commandments &mdash; H4687 מִצְוָה (Mitsvah)</p>
                <p class="text-slate-700 mt-1">Divine ordinance, precept, collective statute of the King.</p>
            </div>
        </div>

        <div class="bg-slate-50 border-t-2 border-caci-purple p-4 rounded-b-lg text-sm text-slate-800 leading-relaxed">
            <strong class="text-caci-minister">Key Understanding:</strong>
            After God took the children of Israel out of Egypt, to make for Himself a nation called by Him, He commanded them to gather manna on days one through six, but on the seventh day, the Sabbath, they would rest. On the sixth day they gathered double to prepare for the Sabbath rest. Notice this was <em>before</em> the Ten Commandments were given on stone at Sinai! God was doing this to prove whether they would walk in His ways or not. He knows whether we are obedient to Him by whether we keep His Sabbath rest.
        </div>
    </section>

    <!-- 3. GOD TELLS US TO MARK THE SABBATH -->
    <section id="commandment" class="card p-6 md:p-8 scroll-mt-24 border-l-8 border-l-caci-tone2">
        <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="badge mb-1">The Decalogue (Mount Sinai)</span>
            <h2 class="text-2xl md:text-3xl font-bold">3. God Tells Us to Mark the Sabbath</h2>
        </div>

        <div class="bg-blue-50/50 p-5 rounded-lg border border-blue-100 mb-6">
            <span class="font-bold text-caci-minister font-head text-lg block mb-1">
                <a href="https://www.blueletterbible.org/kjv/exo/20/8" target="_blank" rel="noopener noreferrer">Exodus 20:8&ndash;11 (KJV) &nearr;</a>
            </span>
            <blockquote class="scripture-quote text-slate-800 text-sm md:text-base leading-relaxed">
                <strong class="text-caci-minister font-bold">Remember the sabbath day, to keep it holy.</strong>
                <strong class="font-bold text-caci-blue">9</strong> Six days shalt thou labour, and do all thy work:
                <strong class="font-bold text-caci-blue">10</strong> But the seventh day is the sabbath of the LORD thy God: in it thou shalt not do any work, thou, nor thy son, nor thy daughter, thy manservant, nor thy maidservant, nor thy cattle, nor thy stranger that is within thy gates:
                <strong class="font-bold text-caci-blue">11</strong> For in six days the LORD made heaven and earth, the sea, and all that in them is, and rested the seventh day: wherefore the LORD blessed the sabbath day, and hallowed it.
            </blockquote>
        </div>

        <div class="grid md:grid-cols-3 gap-3 mb-6">
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Remember &mdash; H2142 זָכַר (zakar)</p>
                <p class="text-slate-700 mt-1">To mark (so as to be recognized), to be mindful of, recount, record, call to remembrance.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Labour &mdash; H5647 עָבַד ('abad)</p>
                <p class="text-slate-700 mt-1">To serve, work, till, produce occupationally.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Hallowed &mdash; H6942 קָדַשׁ (qadash)</p>
                <p class="text-slate-700 mt-1">To pronounce clean, consecrate, dedicate, keep separate from common use.</p>
            </div>
        </div>

        <div class="bg-slate-50 border-t-2 border-caci-tone2 p-4 rounded-b-lg text-sm text-slate-800 leading-relaxed">
            <strong class="text-caci-minister">Key Understanding:</strong>
            God commands us to mark the seventh day as a dedicated day. The first six days of the week are the days we labor, but the seventh is the Sabbath day unto Him. He explicitly roots our weekly cycle in His creation week: He created for six days and ceased on the seventh. He blessed the Sabbath day and declared it separate from all other days.
        </div>
    </section>

    <!-- 4. GOD SAYS THE SABBATH IS A SIGN OF HIS PEOPLE -->
    <section id="sign-covenant" class="card p-6 md:p-8 scroll-mt-24 border-l-8 border-l-caci-red">
        <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="badge badge-urgent mb-1">Perpetual Covenant</span>
            <h2 class="text-2xl md:text-3xl font-bold">4. The Sabbath Is an Everlasting Sign</h2>
        </div>

        <div class="bg-red-50/50 p-5 rounded-lg border border-red-100 mb-6">
            <span class="font-bold text-caci-minister font-head text-lg block mb-1">
                <a href="https://www.blueletterbible.org/kjv/exo/31/12" target="_blank" rel="noopener noreferrer">Exodus 31:12&ndash;17 (KJV) &nearr;</a>
            </span>
            <blockquote class="scripture-quote text-slate-800 text-xs md:text-sm leading-relaxed space-y-2">
                <p>
                    And the LORD spake unto Moses, saying, Speak thou also unto the children of Israel, saying,
                    <strong class="text-caci-minister">Verily my sabbaths ye shall keep: for it is a sign between me and you throughout your generations; that ye may know that I am the LORD that doth sanctify you.</strong>
                    <strong>14</strong> Ye shall keep the sabbath therefore; for it is holy unto you...
                    <strong>16</strong> Wherefore the children of Israel shall keep the sabbath, to observe the sabbath throughout their generations, for a <strong class="text-caci-red">perpetual covenant</strong>.
                    <strong>17</strong> It is a <strong class="text-caci-red">sign between me and the children of Israel for ever</strong>: for in six days the LORD made heaven and earth, and on the seventh day he rested, and was refreshed.
                </p>
            </blockquote>
        </div>

        <div class="grid md:grid-cols-4 gap-3 mb-6">
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Sign &mdash; H226 אוֹת ('owth)</p>
                <p class="text-slate-700 mt-1">A signal, flag, beacon, pledge of covenant, monument, token of ownership.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Shall Keep &mdash; H8104 שָׁמַר (shamar)</p>
                <p class="text-slate-700 mt-1">To hedge about with thorns, guard, protect, attend to, preserve circumspectly.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Perpetual &mdash; H5769 עוֹלָם ('owlam)</p>
                <p class="text-slate-700 mt-1">Concealed horizon, time out of mind, eternity, always, unending.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Covenant &mdash; H1285 בְּרִית (briyth)</p>
                <p class="text-slate-700 mt-1">A divine compact, alliance, pledge of binding fellowship.</p>
            </div>
        </div>

        <div class="bg-slate-50 border-t-2 border-caci-red p-4 rounded-b-lg text-sm text-slate-800 leading-relaxed">
            <strong class="text-caci-minister">Key Understanding:</strong>
            Observing God's Sabbath is the signature mark that we belong to Him and that He is the One who sanctifies us. The Sabbath is a perpetual, never-ending covenant. It is a sign between Him and His people because in six days He created heaven and earth and rested.
        </div>
    </section>

    <!-- 5. LEVITICUS 19 & LEVITICUS 23: THE FEASTS OF THE LORD -->
    <section id="feasts" class="card p-6 md:p-8 scroll-mt-24 border-l-8 border-l-caci-blue">
        <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="badge mb-1">Leviticus 23 &amp; Leviticus 19</span>
            <h2 class="text-2xl md:text-3xl font-bold">5. The Sabbath as a Feast of the LORD (Moed)</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-6">
            <div class="bg-white p-4 rounded border border-slate-200">
                <span class="font-bold text-caci-minister text-sm block mb-1">
                    <a href="https://www.blueletterbible.org/kjv/lev/19/1" target="_blank" rel="noopener noreferrer">Leviticus 19:1&ndash;4 (KJV) &nearr;</a>
                </span>
                <p class="text-xs text-slate-700 italic">
                    Ye shall be holy: for I the LORD your God am holy. Ye shall fear every man his mother, and his father, and <strong>keep my sabbaths: I am the LORD your God</strong>. Turn ye not unto idols...
                </p>
            </div>

            <div class="bg-white p-4 rounded border border-slate-200">
                <span class="font-bold text-caci-minister text-sm block mb-1">
                    <a href="https://www.blueletterbible.org/kjv/lev/23/1" target="_blank" rel="noopener noreferrer">Leviticus 23:1&ndash;3 (KJV) &nearr;</a>
                </span>
                <p class="text-xs text-slate-700 italic">
                    Concerning the <strong>feasts of the LORD</strong>, which ye shall proclaim to be <strong>holy convocations, even these are my feasts</strong>. Six days shall work be done: but the seventh day is the sabbath of rest, an holy convocation; ye shall do no work therein: it is the sabbath of the LORD in all your dwellings.
                </p>
            </div>
        </div>

        <div class="grid md:grid-cols-2 gap-3 mb-6">
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Feasts of the LORD &mdash; H4150 מוֹעֵד (Mow'ed)</p>
                <p class="text-slate-700 mt-1">An appointed time, divine appointment, fixed festival, meeting place, sacred assembly.</p>
            </div>
            <div class="bg-parchment p-3 rounded border border-slate-200 text-xs">
                <p class="font-bold text-caci-minister">Holy Convocation &mdash; H4744 מִקְרָא (Miqra)</p>
                <p class="text-slate-700 mt-1">A public called-out meeting, an assembly of the congregation, a rehearsal.</p>
            </div>
        </div>

        <div class="bg-slate-50 border-t-2 border-caci-blue p-4 rounded-b-lg text-sm text-slate-800 leading-relaxed">
            <strong class="text-caci-minister">Key Understanding:</strong>
            Not only is the Sabbath one of the Ten Commandments, it is the <strong>very first of the Feasts of the LORD</strong> in Leviticus 23! It is a weekly divine appointment (<em>Moed</em>) and a Holy Convocation (<em>Miqra</em>)—a dress rehearsal for the 7th-millennium reign of Messiah.
        </div>
    </section>

    <!-- 6. FOR ALL NATIONS: ISAIAH 56 & 58 -->
    <section id="all-nations" class="card p-6 md:p-8 scroll-mt-24 border-l-8 border-l-caci-purple">
        <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="badge mb-1">Prophetic Ingathering</span>
            <h2 class="text-2xl md:text-3xl font-bold">6. Is the Sabbath Only for Israelites?</h2>
        </div>

        <div class="space-y-4 mb-6">
            <div class="bg-white p-4 rounded border border-slate-200">
                <span class="font-bold text-caci-minister text-sm block mb-1">
                    <a href="https://www.blueletterbible.org/kjv/isa/56/1" target="_blank" rel="noopener noreferrer">Isaiah 56:1&ndash;8 (KJV) &nearr;</a>
                </span>
                <blockquote class="scripture-quote text-slate-700 text-xs leading-relaxed">
                    <strong class="text-caci-minister">Thus saith the LORD, Keep ye judgment, and do justice: for my salvation is near to come, and my righteousness to be revealed.</strong>
