        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="@($"/congregation/{_profile.UrlSlug}/foundations")" class="btn-primary">Explore 12 Foundations Bible Study</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/connect?")from=What%20We%20Believe%20Page" class="btn-secondary">Connect With Us</a>
        </div>
    </section>

</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            TenantContext.SetSlug(Slug);
        }
        _profile = await CongregationService.GetCurrentAsync();
    }

    private CongregationProfile _profile = new();

