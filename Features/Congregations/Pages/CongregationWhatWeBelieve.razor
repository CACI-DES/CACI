@page "/congregation/{Slug}/what-we-believe"
@page "/congregation/{Slug}/WhatWeBelieve"
@page "/congregation/{Slug}/4PillarsInfo"
@page "/congregation/{Slug}/pillars"
@layout CongregationLayout
@using CACI_Life.Core.Domain.Congregations
@inject ICongregationService CongregationService
@inject TenantContext TenantContext

<CongregationSeoHead Title="What We Believe | Apostolic Doctrine, Sabbath & The Kingdom of God"
         Description="@($"Statement of Faith of {_profile.CongregationName}: The original Apostles' doctrine, Acts 2:38 repentance and baptism, the 4 Pillars of apostolic fellowship (Acts 2:42), the Seventh Day Sabbath, biblical feasts, and the coming Kingdom of God on earth.")"
         Path="@($"/congregation/{_profile.UrlSlug}/what-we-believe")" />

<section class="hero py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 text-center">
        <span class="badge uppercase tracking-wider mb-4">Statement of Faith &amp; Apostolic Walk</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6">What We Believe</h1>
        <div class="max-w-3xl mx-auto">
            <p class="text-xl md:text-2xl text-slate-100 font-head italic mb-4">
                &ldquo;And this gospel of the kingdom shall be preached in all the world for a witness unto all nations; and then shall the end come.&rdquo;
            </p>
            <p class="text-sm font-semibold text-caci-tone3 uppercase tracking-widest">&mdash; Matthew 24:14 (KJV)</p>
            <p class="mt-6 text-base md:text-lg text-slate-200 leading-relaxed">
                Jesus / Yeshua said the &ldquo;Gospel of the Kingdom&rdquo; will be proclaimed in all of the world, to be a testimony to all of the nations.
            </p>
        </div>

        <!-- Quick Jump Navigation -->
        <nav aria-label="Belief Topics" class="mt-10 flex flex-wrap justify-center gap-2 md:gap-3 text-sm">
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")commission" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">The Great Commission</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")why-apostolic" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">Why Apostolic? (4 Pillars)</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")doctrine" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">1. Doctrine</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")fellowship" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">2. Fellowship &amp; Worship</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")breaking-bread" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">3. Breaking Bread</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")prayer" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">4. Prayer</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")why-covenant" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">Why Covenant?</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")law" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">The Law Written on Hearts</a>
            <a href="@($"/congregation/{_profile.UrlSlug}/what-we-believe#")instructions" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 no-underline transition">Kingdom Culture (Torah)</a>
        </nav>
    </div>
</section>

<div class="max-w-5xl mx-auto px-4 py-12 space-y-16">

    <!-- THE GREAT COMMISSION SECTION -->
    <section id="commission" class="scroll-mt-24">
        <div class="text-center mb-8">
            <span class="badge">The Master's Commission</span>
            <h2 class="text-3xl md:text-4xl font-bold mt-2">The Gospel of the Kingdom</h2>
            <div class="section-rule mx-auto my-4"></div>
            <p class="text-slate-600 max-w-2xl mx-auto">
                Before His ascension, Yeshua commanded His disciples to proclaim repentance, remission of sins, and the culture of the Kingdom to all nations.
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
            <!-- Matthew 28:18-20 -->
            <article class="card p-6 flex flex-col justify-between border-t-4 border-t-caci-blue">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="font-bold text-caci-minister font-head text-lg">Matthew 28:18&ndash;20</span>
                        <a href="https://www.blueletterbible.org/kjv/mat/28/18" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2 hover:underline" aria-label="Matthew 28:18 on Blue Letter Bible">KJV &nearr;</a>
                    </div>
                    <blockquote class="text-sm text-slate-700 leading-relaxed scripture-quote">
                        And Jesus came and spake unto them, saying, <strong class="text-caci-minister">All power is given unto me in heaven and in earth.</strong>
                        <strong class="font-bold text-caci-blue">19</strong> Go ye therefore, and teach all nations, baptizing them in the name of the Father, and of the Son, and of the Holy Ghost:
                        <strong class="font-bold text-caci-blue">20</strong> Teaching them to observe all things whatsoever I have commanded you: and, lo, I am with you alway, [even] unto the end of the world. Amen.
                    </blockquote>
                </div>
            </article>

            <!-- Mark 16:15-20 -->
            <article class="card p-6 flex flex-col justify-between border-t-4 border-t-caci-tone2">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="font-bold text-caci-minister font-head text-lg">Mark 16:15&ndash;20</span>
                        <a href="https://www.blueletterbible.org/kjv/mar/16/15" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2 hover:underline" aria-label="Mark 16:15 on Blue Letter Bible">KJV &nearr;</a>
                    </div>
                    <blockquote class="text-sm text-slate-700 leading-relaxed scripture-quote">
                        And he said unto them, <strong class="text-caci-minister">Go ye into all the world, and preach the gospel to every creature.</strong>
                        <strong class="font-bold text-caci-blue">16</strong> He that believeth and is baptized shall be saved; but he that believeth not shall be damned.
                        <strong class="font-bold text-caci-blue">17</strong> And these signs shall follow them that believe; In my name shall they cast out devils; they shall speak with new tongues;
                        <strong class="font-bold text-caci-blue">18</strong> They shall take up serpents; and if they drink any deadly thing, it shall not hurt them; they shall lay hands on the sick, and they shall recover.
                        <strong class="font-bold text-caci-blue">19</strong> So then after the Lord had spoken unto them, he was received up into heaven, and sat on the right hand of God.
                        <strong class="font-bold text-caci-blue">20</strong> And they went forth, and preached every where, the Lord working with [them], and confirming the word with signs following. Amen.
                    </blockquote>
                </div>
            </article>

            <!-- Luke 24:44-53 -->
            <article class="card p-6 flex flex-col justify-between border-t-4 border-t-caci-purple">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="font-bold text-caci-minister font-head text-lg">Luke 24:44&ndash;53</span>
                        <a href="https://www.blueletterbible.org/kjv/luk/24/44" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2 hover:underline" aria-label="Luke 24:44 on Blue Letter Bible">KJV &nearr;</a>
                    </div>
                    <blockquote class="text-sm text-slate-700 leading-relaxed scripture-quote">
                        And he said unto them, These [are] the words which I spake unto you, while I was yet with you, that all things must be fulfilled, which were written in the law of Moses, and [in] the prophets, and [in] the psalms, concerning me.
                        <strong class="font-bold text-caci-blue">45</strong> Then opened he their understanding, that they might understand the scriptures,
                        <strong class="font-bold text-caci-blue">46</strong> And said unto them, Thus it is written, and thus it behoved Christ to suffer, and to rise from the dead the third day:
                        <strong class="font-bold text-caci-blue">47</strong> And that repentance and remission of sins should be preached in his name among all nations, beginning at Jerusalem.
                        <strong class="font-bold text-caci-blue">48</strong> And ye are witnesses of these things.
                        <strong class="font-bold text-caci-blue">49</strong> And, behold, I send the promise of my Father upon you: but tarry ye in the city of Jerusalem, until ye be endued with power from on high...
                    </blockquote>
                </div>
            </article>
        </div>
    </section>

    <!-- SECTION 1: WHY APOSTOLIC? -->
    <section id="why-apostolic" class="scroll-mt-24">
        <div class="text-center mb-10">
            <span class="badge">The Foundation of Apostles and Prophets</span>
            <h2 class="text-3xl md:text-5xl font-bold mt-2">Why Apostolic?</h2>
            <div class="section-rule mx-auto my-4"></div>
            <p class="text-lg text-slate-700 max-w-3xl mx-auto">
                We pattern our congregational life after the first-century assembly of Yeshua's apostles, steadfastly guarding the order, doctrine, fellowship, and supernatural power of the Holy Spirit.
            </p>
        </div>

        <!-- Foundational Scripture Banner -->
        <div class="grid md:grid-cols-2 gap-4 mb-10">
            <div class="card p-6 bg-parchment border-l-4 border-l-caci-blue">
                <div class="flex items-center justify-between mb-2">
                    <span class="font-bold text-caci-minister font-head">1 Corinthians 11:1</span>
                    <a href="https://www.blueletterbible.org/kjv/1co/11/1" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2 hover:underline">KJV &nearr;</a>
                </div>
                <blockquote class="scripture-quote text-slate-800">
                    &ldquo;Be ye followers of me, even as I also am of Christ.&rdquo;
                </blockquote>
            </div>

            <div class="card p-6 bg-parchment border-l-4 border-l-caci-purple">
                <div class="flex items-center justify-between mb-2">
                    <span class="font-bold text-caci-minister font-head">Acts 2:42</span>
                    <a href="https://www.blueletterbible.org/kjv/act/2/42" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2 hover:underline">KJV &nearr;</a>
                </div>
                <blockquote class="scripture-quote text-slate-800">
                    &ldquo;And they continued stedfastly in the apostles' doctrine and fellowship, and in breaking of bread, and in prayers.&rdquo;
                </blockquote>
            </div>
        </div>

        <!-- THE FOUR PILLARS CONTAINER -->
        <div class="space-y-8">

            <!-- PILLAR 1: DOCTRINE -->
            <div id="doctrine" class="card p-6 md:p-8 scroll-mt-24 border-l-8 border-l-caci-blue">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-4 mb-6">
                    <div>
                        <span class="badge mb-1">Pillar One</span>
                        <h3 class="text-2xl md:text-3xl font-bold">The Apostles' Doctrine</h3>
                    </div>
                    <a href="https://www.blueletterbible.org/kjv/eph/4/4" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-caci-tone2 hover:underline">
                        Ephesians 4:4&ndash;6 (KJV) &nearr;
                    </a>
                </div>

                <div class="bg-blue-50/50 border border-blue-100 rounded-lg p-5 mb-6 text-slate-800">
                    <p class="font-head italic text-base md:text-lg mb-2">
                        &ldquo;[There is] one body, and one Spirit, even as ye are called in one hope of your calling; One Lord, one faith, one baptism, One God and Father of all, who [is] above all, and through all, and in you all.&rdquo;
                    </p>
                    <p class="text-xs font-semibold text-caci-blue uppercase tracking-wider">&mdash; Ephesians 4:4&ndash;6</p>
                </div>

                <div class="space-y-4">

                    <!-- Sub-Topic: Spirit -->
                    <details class="faq-item" open>
                        <summary>
                            <span class="flex items-center gap-3">
                                <span class="w-8 h-8 rounded-full bg-blue-100 text-caci-blue flex items-center justify-center font-bold text-sm">1</span>
                                <span class="text-lg">The Holy Spirit &amp; His Operation</span>
                            </span>
                        </summary>
                        <div class="faq-answer space-y-6 pt-2">
                            <p class="text-slate-700 leading-relaxed">
                                The Holy Spirit is very important for a believer. Unfortunately, most of the church world has minimized the Holy Spirit and therefore a lot of people don't understand the significance and the power that is given to us if we embrace it. Jesus / Yeshua said the things He did and greater, we would do.
                            </p>

                            <div class="grid md:grid-cols-2 gap-4">
                                <div class="bg-parchment p-4 rounded-lg border border-slate-200">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="font-bold text-caci-minister text-sm">John 14:12</span>
                                        <a href="https://www.blueletterbible.org/kjv/joh/14/12" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2">KJV &nearr;</a>
                                    </div>
                                    <p class="text-xs text-slate-700 italic">
                                        Verily, verily, I say unto you, He that believeth on me, the works that I do shall he do also; and greater [works] than these shall he do; because I go unto my Father.
                                    </p>
                                </div>

                                <div class="bg-parchment p-4 rounded-lg border border-slate-200">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="font-bold text-caci-minister text-sm">Mark 16:17&ndash;18</span>
                                        <a href="https://www.blueletterbible.org/kjv/mar/16/17" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2">KJV &nearr;</a>
                                    </div>
                                    <p class="text-xs text-slate-700 italic">
                                        And these signs shall follow them that believe; In my name shall they cast out devils; they shall speak with new tongues; <strong>18</strong> They shall take up serpents; and if they drink any deadly thing, it shall not hurt them; they shall lay hands on the sick, and they shall recover.
                                    </p>
                                </div>

                                <div class="bg-parchment p-4 rounded-lg border border-slate-200">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="font-bold text-caci-minister text-sm">Joel 2:28</span>
                                        <a href="https://www.blueletterbible.org/kjv/joe/2/28" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2">KJV &nearr;</a>
                                    </div>
                                    <p class="text-xs text-slate-700 italic">
                                        And it shall come to pass afterward, [that] I will pour out my spirit upon all flesh; and your sons and your daughters shall prophesy, your old men shall dream dreams, your young men shall see visions:
                                    </p>
                                </div>

                                <div class="bg-parchment p-4 rounded-lg border border-slate-200">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="font-bold text-caci-minister text-sm">Acts 2:14&ndash;18</span>
                                        <a href="https://www.blueletterbible.org/kjv/act/2/14" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2">KJV &nearr;</a>
                                    </div>
                                    <p class="text-xs text-slate-700 italic">
                                        But Peter, standing up with the eleven, lifted up his voice, and said unto them, Ye men of Judaea, and all ye that dwell at Jerusalem, be this known unto you... <strong>17</strong> And it shall come to pass in the last days, saith God, I will pour out of my Spirit upon all flesh...
                                    </p>
                                </div>
                            </div>

                            <!-- Walk in the Spirit -->
                            <div class="border-t border-slate-200 pt-4">
                                <h4 class="font-head font-bold text-lg text-caci-blue mb-3">Walk in the Spirit</h4>
                                <div class="space-y-3">
                                    <div class="bg-white p-3 rounded border border-slate-200">
                                        <span class="font-semibold text-xs text-caci-minister block mb-1">
                                            <a href="https://www.blueletterbible.org/kjv/gal/5/16" target="_blank" rel="noopener noreferrer">Galatians 5:16 (KJV) &nearr;</a>
                                        </span>
                                        <p class="text-xs text-slate-700 italic">
                                            [This] I say then, Walk in the Spirit, and ye shall not fulfil the lust of the flesh.
                                        </p>
                                    </div>
                                    <div class="bg-white p-3 rounded border border-slate-200">
                                        <span class="font-semibold text-xs text-caci-minister block mb-1">
                                            <a href="https://www.blueletterbible.org/kjv/jer/31/33" target="_blank" rel="noopener noreferrer">Jeremiah 31:33 (KJV) &nearr;</a>
                                        </span>
                                        <p class="text-xs text-slate-700 italic">
                                            But this shall be the covenant that I will make with the house of Israel; After those days, saith the LORD, I will put my law in their inward parts, and write it in their hearts; and will be their God, and they shall be my people.
                                        </p>
                                    </div>
                                    <div class="bg-white p-3 rounded border border-slate-200">
                                        <span class="font-semibold text-xs text-caci-minister block mb-1">
                                            <a href="https://www.blueletterbible.org/kjv/heb/8/10" target="_blank" rel="noopener noreferrer">Hebrews 8:10 (KJV) &nearr;</a>
                                        </span>
                                        <p class="text-xs text-slate-700 italic">
                                            For this is the covenant that I will make with the house of Israel after those days, saith the Lord; I will put my laws into their mind, and write them in their hearts: and I will be to them a God, and they shall be to me a people:
                                        </p>
                                    </div>
                                    <div class="bg-white p-3 rounded border border-slate-200">
                                        <span class="font-semibold text-xs text-caci-minister block mb-1">
                                            <a href="https://www.blueletterbible.org/kjv/eze/36/26" target="_blank" rel="noopener noreferrer">Ezekiel 36:26&ndash;27 (KJV) &nearr;</a>
                                        </span>
                                        <p class="text-xs text-slate-700 italic">
                                            A new heart also will I give you, and a new spirit will I put within you: and I will take away the stony heart out of your flesh, and I will give you an heart of flesh. <strong>27</strong> And I will put my spirit within you, and cause you to walk in my statutes, and ye shall keep my judgments, and do [them].
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Fruit of the Spirit -->
                            <div class="border-t border-slate-200 pt-4">
                                <h4 class="font-head font-bold text-lg text-caci-blue mb-3">Fruit of the Spirit</h4>
                                <div class="bg-white p-4 rounded border border-slate-200">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="font-bold text-caci-minister text-sm">Galatians 5:22&ndash;25</span>
                                        <a href="https://www.blueletterbible.org/kjv/gal/5/22" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2">KJV &nearr;</a>
                                    </div>
                                    <p class="text-sm text-slate-700 italic">
                                        But the fruit of the Spirit is love, joy, peace, longsuffering, gentleness, goodness, faith, <strong>23</strong> Meekness, temperance: against such there is no law. <strong>24</strong> And they that are Christ's have crucified the flesh with the affections and lusts. <strong>25</strong> If we live in the Spirit, let us also walk in the Spirit.
                                    </p>
                                </div>
                            </div>

                            <!-- Spiritual Gifts -->
                            <div class="border-t border-slate-200 pt-4">
                                <h4 class="font-head font-bold text-lg text-caci-blue mb-3">Spiritual Gifts</h4>
                                <div class="bg-white p-4 rounded border border-slate-200">
                                    <div class="flex justify-between items-center mb-2">
                                        <span class="font-bold text-caci-minister text-sm">1 Corinthians 12:1&ndash;11</span>
                                        <a href="https://www.blueletterbible.org/kjv/1co/12/1" target="_blank" rel="noopener noreferrer" class="text-xs text-caci-tone2">KJV &nearr;</a>
                                    </div>
                                    <p class="text-xs text-slate-700 italic leading-relaxed">
                                        Now concerning spiritual [gifts], brethren, I would not have you ignorant. <strong>2</strong> Ye know that ye were Gentiles, carried away unto these dumb idols, even as ye were led. <strong>3</strong> Wherefore I give you to understand, that no man speaking by the Spirit of God calleth Jesus accursed: and [that] no man can say that Jesus is the Lord, but by the Holy Ghost. <strong>4</strong> Now there are diversities of gifts, but the same Spirit. <strong>5</strong> And there are differences of administrations, but the same Lord. <strong>6</strong> And there are diversities of operations, but it is the same God which worketh all in all. <strong>7</strong> But the manifestation of the Spirit is given to every man to profit withal. <strong>8</strong> For to one is given by the Spirit the word of wisdom; to another the word of knowledge by the same Spirit; <strong>9</strong> To another faith by the same Spirit; to another the gifts of healing by the same Spirit; <strong>10</strong> To another the working of miracles; to another prophecy; to another discerning of spirits; to another [divers] kinds of tongues; to another the interpretation of tongues: <strong>11</strong> But all these worketh that one and the selfsame Spirit, dividing to every man severally as he will.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </details>

                    <!-- Sub-Topic: One Lord -->
                    <details class="faq-item">
                        <summary>
                            <span class="flex items-center gap-3">
                                <span class="w-8 h-8 rounded-full bg-blue-100 text-caci-blue flex items-center justify-center font-bold text-sm">2</span>
                                <span class="text-lg">One Lord &mdash; God is One</span>
                            </span>
                        </summary>
                        <div class="faq-answer space-y-4 pt-2">
                            <p class="text-slate-700 font-semibold">
                                There is only one God and He is the same Yesterday, Today, and Forever.
                            </p>
                            <div class="grid md:grid-cols-3 gap-3">
                                <div class="bg-parchment p-4 rounded border border-slate-200">
                                    <span class="font-bold text-caci-minister text-xs block mb-1">
                                        <a href="https://www.blueletterbible.org/kjv/deu/6/4" target="_blank" rel="noopener noreferrer">Deuteronomy 6:4 (KJV) &nearr;</a>
                                    </span>
                                    <p class="text-xs text-slate-700 italic">
                                        Hear, O Israel: The LORD our God [is] one LORD:
                                    </p>
                                </div>
                                <div class="bg-parchment p-4 rounded border border-slate-200">
                                    <span class="font-bold text-caci-minister text-xs block mb-1">
                                        <a href="https://www.blueletterbible.org/kjv/zech/14/9" target="_blank" rel="noopener noreferrer">Zechariah 14:9 (KJV) &nearr;</a>
                                    </span>
                                    <p class="text-xs text-slate-700 italic">
                                        And the LORD shall be king over all the earth: in that day shall there be one LORD, and his name one.
                                    </p>
                                </div>
                                <div class="bg-parchment p-4 rounded border border-slate-200">
                                    <span class="font-bold text-caci-minister text-xs block mb-1">
                                        <a href="https://www.blueletterbible.org/kjv/eph/4/6" target="_blank" rel="noopener noreferrer">Ephesians 4:6 (KJV) &nearr;</a>
                                    </span>
                                    <p class="text-xs text-slate-700 italic">
                                        One God and Father of all, who [is] above all, and through all, and in you all.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </details>

                    <!-- Sub-Topic: One Faith -->
                    <details class="faq-item">
                        <summary>
                            <span class="flex items-center gap-3">
                                <span class="w-8 h-8 rounded-full bg-blue-100 text-caci-blue flex items-center justify-center font-bold text-sm">3</span>
                                <span class="text-lg">One Faith &mdash; The Coming King &amp; His Kingdom</span>
                            </span>
                        </summary>
                        <div class="faq-answer space-y-6 pt-2">
