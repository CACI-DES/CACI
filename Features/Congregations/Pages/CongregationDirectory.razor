@page "/congregations"
@page "/churches"
@using CACI_Life.Core.Domain.Congregations
@inject ICongregationService CongregationService

<HeadContent>
    <title>CACI Congregations Directory | Covenant Apostolic Congregations International</title>
    <meta name="description" content="Find a local Covenant Apostolic congregation near you. Whole-Bible, Spirit-filled Apostolic Sabbath-keeping assemblies across the nation." />
    <link rel="canonical" href="https://caci.life/congregations" />
</HeadContent>

<section class="relative bg-gradient-to-br from-[#001F5C] via-[#174477] to-[#47306D] text-white py-16 md:py-24 text-center">
    <div class="max-w-4xl mx-auto px-4">
        <span class="inline-block py-1 px-4 rounded-full text-xs font-semibold tracking-wider uppercase bg-white/20 text-white border border-white/30 mb-4">
            Fellowship Network
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4">
            CACI Congregations
        </h1>
        <p class="text-xl text-slate-100 max-w-2xl mx-auto font-head italic mb-6">
            “All The Word To All The World”
        </p>
        <p class="text-base text-slate-200 max-w-2xl mx-auto leading-relaxed">
            Find an aligned Apostolic Sabbath-keeping fellowship in your region, or connect with our elders for personal Bible studies and fellowship online.
        </p>
    </div>
</section>

<section class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 border-b border-slate-200 mb-8">
        <div>
            <h2 class="text-2xl md:text-3xl font-extrabold text-[#174477]">Affiliated Assemblies</h2>
            <p class="text-sm text-slate-600 mt-1">Showing @(_congregations.Count) constituent fellowship@(_congregations.Count == 1 ? "" : "s")</p>
        </div>
        <div>
            <a href="/login" class="text-xs font-semibold text-[#174477] hover:underline">
                Minister &amp; Leadership Portal &rarr;
            </a>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-12 text-slate-500">
            <p>Loading congregations...</p>
        </div>
    }
    else if (_congregations.Count == 0)
    {
        <div class="text-center py-12 bg-slate-50 rounded-2xl border border-slate-200 p-8">
            <h3 class="text-xl font-bold text-slate-700">No Congregations Listed</h3>
            <p class="text-slate-500 mt-2 text-sm">Please check back soon as our assembly directory is updated.</p>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var c in _congregations)
            {
                <article class="bg-white rounded-2xl border border-slate-200 hover:border-[#174477] hover:shadow-xl transition-all duration-200 p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-16 h-16 rounded-xl bg-slate-50 p-2 border border-slate-200 flex items-center justify-center shrink-0">
                                <img src="@c.EffectiveLogo" alt="@c.CongregationName" class="max-h-12 w-auto" />
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-[#174477] leading-snug">
                                    <a href="@($"/congregation/{c.UrlSlug}")" class="text-inherit hover:underline">
                                        @c.CongregationName
                                    </a>
                                </h3>
                                <p class="text-xs text-slate-500">@c.Subtitle</p>
                            </div>
                        </div>

                        <div class="space-y-2 text-xs text-slate-600 mt-2">
                            @if (!string.IsNullOrWhiteSpace(c.PastorName))
                            {
                                <p class="flex items-center gap-1.5">
                                    <span class="font-semibold text-slate-700">Pastor:</span> @c.PastorName
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.FullAddress))
                            {
                                <p class="flex items-start gap-1.5">
                                    <span class="font-semibold text-slate-700 shrink-0">Location:</span>
                                    <span>@c.FullAddress</span>
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.ServiceSchedule))
                            {
                                <p class="flex items-start gap-1.5 text-[#174477] font-medium">
                                    <span class="font-semibold shrink-0">Schedule:</span>
                                    <span>@c.ServiceSchedule</span>
                                </p>
                            }
                        </div>
                    </div>

                    <div class="pt-4 mt-6 border-t border-slate-100 flex items-center justify-between gap-2">
                        <a href="@($"/congregation/{c.UrlSlug}")" class="inline-flex items-center gap-1 text-xs font-bold text-[#174477] hover:text-[#001F5C]">
                            Visit Assembly Page &rarr;
                        </a>
                        <a href="@($"/congregation/{c.UrlSlug}/connect")" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-800">
                            Connect
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<CongregationProfile> _congregations = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _congregations = await CongregationService.GetAllActiveAsync();
        _isLoading = false;
    }
}
