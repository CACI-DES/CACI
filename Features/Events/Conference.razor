@using CACI_Life.Features.Events.Models
@using CACI_Life.Features.Events
@inject IEventsRepository EventsRepo

<PageTitle>@(ActiveConference?.Title ?? "Exodus Family Conference 2026")</PageTitle>

<HeadContent>
    <style>
        /* Smooth transition for buttons */
        .cta-button {
        transition: all 0.3s ease;
        background-color: #C8102E; /* elder-red */
        color: #FFFFFF;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
    }

    .cta-button:hover {
    background-color: #6696C5; /* tone-2 */
    color: #C8102E;
}

/* Hero section background */
.hero-bg {
background-color: #174477;
}

/* Overlay to darken the image and make text pop */
.hero-overlay {
background-color: rgba(23, 68, 119, 0.65);
}

.title-font {
font-family: 'Playfair Display', serif;
letter-spacing: 0.05em;
}

/* Custom theme colors mapped as utility classes to make the copied HTML markup work */
.bg-dark { background-color: #174477 !important; }
.bg-medium { background-color: #6696C5 !important; }
.bg-light { background-color: #A4BDDD !important; }
.text-dark { color: #174477 !important; }
.text-medium { color: #6696C5 !important; }
.text-light { color: #A4BDDD !important; }
.border-dark { border-color: #174477 !important; }
.border-medium { border-color: #6696C5 !important; }
.border-light { border-color: #A4BDDD !important; }
</style>
</HeadContent>

<div class="min-h-screen bg-gray-50 font-sans">

    <!-- 1. Hero Section - The Main Call to Action -->
    <main class="hero-bg">
        <div class="hero-overlay flex min-h-[100vh] items-start justify-center p-2 sm:p-4">
            <div class="max-w-4xl space-y-6 rounded-xl px-4 py-6 text-center text-white shadow-2xl backdrop-blur-sm sm:px-10 sm:py-8">
                <img src="@(ActiveConference?.ImageUrl ?? "/images/EFC2026/Kingdom Gospel 3B FINAL.png")" alt="Kingdom Gospel" class="w-full max-w-[560px] h-auto rounded-xl shadow-lg" style="margin: auto;">
                <br />

                <!-- Theme Tagline -->
                <p class="mb-1 pb-0 text-xl font-bold sm:text-3xl md:text-4xl">
                    @(ActiveConference?.Title ?? "EXODUS FAMILY CONFERENCE 2026")
                </p>
                <p class="pt-0 text-lg font-light sm:text-xl md:text-2xl">
                    @(ActiveConference?.Description ?? "Join us for an unforgettable experience!")
                </p>
                <iframe class="w-full aspect-video rounded-xl shadow-md"
                src="@(ActiveConference?.YoutubeLink ?? "https://www.youtube.com/embed/R03FJjwq0aM?si=lw1IM5AIHM9yAJRZ")"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                muted>
            </iframe>

            <!-- Key Dates & Location -->
            <div class="space-y-2 pt-2">
                <div class="inline-block rounded-lg bg-medium p-2 shadow-xl">
                    <p class="text-2xl font-bold sm:text-3xl">
                        @if (ActiveConference != null)
                        {
                            @($"{ActiveConference.StartDate:MMMM dd} - {ActiveConference.EndDate:MMMM dd, yyyy}")
                        }
                        else
                        {
                            @("April 22 - 25, 2026")
                        }
                    </p>
                </div>
                <p class="text-xl font-semibold">
                    @(ActiveConference?.Location ?? "MOBILE, ALABAMA")
                </p>
            </div>

            <!-- Registration Call to Action Area -->
            <div class="pt-0" id="cta">
                @if (ActiveConference?.RegistrationOpen ?? true)
                {
                    <!-- Registration Button pointing to events.caci.life registration page -->
                    <a href="https://events.caci.life/Registration" target="_blank" class="cta-button w-full transform rounded-full bg-light px-10 py-4 text-xl font-extrabold text-dark shadow-lg transition duration-300 ease-in-out hover:scale-[1.02] hover:bg-white hover:shadow-2xl sm:w-auto">
                        Register Now
                    </a>
                }
                else
                {
                    <span class="cta-button w-full inline-block rounded-full bg-gray-400 px-10 py-4 text-xl font-extrabold text-white shadow-lg text-center cursor-default sm:w-auto">
                        Registration Opens July 19th
                    </span>
                }
            </div>

        </div>
    </div>
</main>

<!-- 2. Full Schedule Section -->
@* <ConferenceSchedule /> *@

