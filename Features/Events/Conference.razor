<!-- 5. Sponsorship Packages Section -->
<section class="bg-dark py-16 text-white" id="sponsorship">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h3 class="mb-6 text-center text-4xl font-extrabold text-white">
            Business Sponsorship Packages
        </h3>
        <p class="mx-auto mb-12 max-w-3xl text-center text-lg font-medium text-gray-200">
            Your partnership enables CACI to keep event costs affordable, and helps individuals and families to attend. These sponsorships are vital to the overall success and spiritual outcomes of our Conferences!
        </p>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
            @if (Packages != null)
            {
                foreach (var pkg in Packages)
                {
                    <SponsorCard Level="@pkg.PackageName"
                    Price="@pkg.PackagePrice"
                    Benefits="@pkg.DescriptionPoints"
                    ShowCta="false" />
                }
            }
        </div>

        <!-- Call to Action pointing to events.caci.life sponsorship page -->
        <div class="mt-12 text-center">
            <a href="https://cacievents.com/sponsorship" target="_blank" class="inline-block transform rounded-full bg-yellow-400 px-10 py-4 text-xl font-extrabold text-gray-900 shadow-lg transition duration-300 ease-in-out hover:scale-105 hover:bg-yellow-300 hover:shadow-2xl">
                Sponsor This Event
            </a>
        </div>

    </div>
</section>

<!-- 6. Contact Section -->
<section class="bg-gray-100 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <h3 class="mb-8 text-4xl font-extrabold text-dark">
            Questions? Contact Us.
        </h3>

        <div class="mx-auto grid max-w-2xl gap-8 md:grid-cols-2">
            <!-- Contact 1 -->
            <div class="rounded-xl border-l-4 border-medium bg-white p-6 shadow-lg">
                <p class="mb-2 text-xl font-bold text-dark">Elder Jason Humphreys</p>
                <a href="tel:9379025726" class="text-lg text-gray-700 transition hover:text-medium">Phone: 937.902.5726</a>
            </div>
            <!-- Contact 2 -->
            <div class="rounded-xl border-l-4 border-medium bg-white p-6 shadow-lg">
                <p class="mb-2 text-xl font-bold text-dark">Bishop Mark Jackson</p>
                <a href="tel:2512669862" class="text-lg text-gray-700 transition hover:text-medium">Phone: 251.266.9862</a>
            </div>
        </div>

    </div>
</section>

</div>

@code {
    private IEnumerable<SponsorPackageModel>? Packages { get; set; }
    private ConferenceModel? ActiveConference { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ActiveConference = await EventsRepo.GetActiveConferenceAsync();
            Packages = await EventsRepo.GetSponsorPackagesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching conference details: {ex.Message}");
        }
    }
}