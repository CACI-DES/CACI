@page "/"
@using CACI_Life.Features.SiteMedia
@inject NavigationManager Navigation
@inject ISubsiteContext SubsiteContext
@inject ISiteMediaService SiteMedia

<style>
    .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    background: url('/images/images/placeholder_video.jpg') center center / cover no-repeat;
}

.video-overlay {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
background: linear-gradient(rgba(23, 68, 119, 0.55), rgba(0, 31, 92, 0.65));
z-index: 1;
pointer-events: none;
}

/* Ensure content stays on top */
.hero-content {
z-index: 2;
}

/* Countdown Styles */
.countdown-timer {
height: 200px;
background: linear-gradient(135deg, #1e3a8a 0%, #001f5c 100%);
display: flex;
justify-content: center;
align-items: center;
gap: 15px;
color: white;
padding: 20px;
position: relative;
overflow: hidden;
}

.countdown-timer::before {
content: "";
position: absolute;
top: 0; left: 0; width: 100%; height: 100%;
background-image: var(--countdown-bg, url('/images/images/Sabbath.png')), url('/images/images/Sabbath.png');
background-size: cover;
background-position: center;
opacity: 0.15;
z-index: 0;
}

.countdown-unit {
text-align: center;
z-index: 1;
background: rgba(255, 255, 255, 0.1);
padding: 10px;
border-radius: 8px;
min-width: 60px;
backdrop-filter: blur(5px);
border: 1px solid rgba(255, 255, 255, 0.2);
}

.countdown-value {
display: block;
font-size: 1.8rem;
font-weight: 700;
line-height: 1;
color: #fbbf24; /* Amber accent */
}

.countdown-label {
font-size: 0.7rem;
text-transform: uppercase;
letter-spacing: 1px;
opacity: 0.8;
}

.countdown-title {
position: absolute;
top: 15px;
left: 20px;
font-size: 0.8rem;
font-weight: 600;
text-transform: uppercase;
letter-spacing: 2px;
color: rgba(255,255,255,0.7);
z-index: 1;
}
</style>


@if (SubsiteContext.IsSubsite && SubsiteContext.Configuration != null)
{
    <DoctrinalFunnelEngine Config="@SubsiteContext.Configuration" IsSubsiteMode="true" />
}
else if (IsEventsDomain)
{
    <Conference />
}
else
{
