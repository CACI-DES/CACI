@implements IDisposable
@using System.Timers
@using CACI_Life.Features.Home

@code {
    private TimeSpan timeLeft;
    private Timer? timer;
    private DateTime targetDate = new DateTime(2026, 9, 27, 0, 0, 0, DateTimeKind.Unspecified);
    private bool IsEventsDomain { get; set; }
    private IReadOnlyDictionary<string, SiteMediaItem> _media =
        new Dictionary<string, SiteMediaItem>(StringComparer.OrdinalIgnoreCase);

    private string HeroVideoUrl => SiteMediaHelper.GetUrl(_media, SiteMediaKeys.HomeHeroVideo);
    private string HeroVideoDefaultUrl => SiteMediaHelper.GetDefaultUrl(SiteMediaKeys.HomeHeroVideo);
    private string HeroVideoMimeType => SiteMediaHelper.GetVideoMimeType(HeroVideoUrl);
    private string HeroVideoPosterUrl => SiteMediaHelper.GetUrl(_media, SiteMediaKeys.HomeHeroVideoPoster);
    private string LeadershipImageUrl => SiteMediaHelper.GetUrl(_media, SiteMediaKeys.HomeLeadershipImage);
    private string LeadershipImageAlt => SiteMediaHelper.GetAlt(_media, SiteMediaKeys.HomeLeadershipImage);
    private string InvolvedBibleStudyUrl => SiteMediaHelper.GetUrl(_media, SiteMediaKeys.HomeInvolvedBibleStudy);
    private string InvolvedBibleStudyAlt => SiteMediaHelper.GetAlt(_media, SiteMediaKeys.HomeInvolvedBibleStudy);
    private string InvolvedSabbathUrl => SiteMediaHelper.GetUrl(_media, SiteMediaKeys.HomeInvolvedSabbath);
    private string InvolvedSabbathAlt => SiteMediaHelper.GetAlt(_media, SiteMediaKeys.HomeInvolvedSabbath);
    private string CountdownBackgroundUrl => SiteMediaHelper.GetUrl(_media, SiteMediaKeys.HomeCountdownBackground);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = new Uri(Navigation.Uri);
            IsEventsDomain = uri.Host.Contains("events.caci.life", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            IsEventsDomain = false;
        }

        if (SubsiteContext.IsSubsite || IsEventsDomain) return;

        _media = await SiteMedia.GetAllAsync();

        CalculateTimeLeft();
        timer = new Timer(1000);
        timer.Elapsed += (s, e) => InvokeAsync(() =>
        {
            CalculateTimeLeft();
            StateHasChanged();
        });
        timer.Start();
    }

    private void CalculateTimeLeft()
    {
        var now = TimeHelper.GetCentralTime();
        if (targetDate > now)
        {
            timeLeft = targetDate - now;
        }
        else
        {
            timeLeft = TimeSpan.Zero;
        }
    }

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }
}