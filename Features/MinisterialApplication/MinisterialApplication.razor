        new CovQuestion("UnityNonFundamentals", "Do you agree to work in unity with other Ministers who may not hold your same views on doctrinal matters outside of the Fundamental Doctrinal Statement of the CACI?", new[] { "Yes", "No" }),
        new CovQuestion("UnityRestoredMinisters", "Do you agree to work in unity with restored Ministers within the CACI?", new[] { "Yes", "No" }),
