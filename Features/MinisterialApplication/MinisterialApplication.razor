        new RepQuestion("ConsentBackgroundCheck", "Do you consent to a background check?")
    };

    private record CovQuestion(string Key, string Question, string[] Options);
    private static readonly CovQuestion[] CovenantQuestions = new[]
    {
        new CovQuestion("FulfillObligations", "Do you accept, and will you faithfully fulfill the obligations of ministry as expected by the CACI fellowship to the best of your abilities?", new[] { "Yes", "No", "Maybe" }),
        new CovQuestion("DisputeResolutionBiblicalNoLawsuit", "Do you agree to follow biblical principles for resolving any dispute with the CACI body, a CACI leader, or another CACI member, rather than by a lawsuit? (Matthew 18:15-18; 1 Corinthians 6:1-7)", new[] { "Yes", "No" }),
