        {
            <div class="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
                <div class="bg-slate-900 border border-white/10 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
                    <div class="flex items-center justify-between border-b border-white/10 pb-3">
                        <h3 class="text-base font-bold text-white">Resume Saved Application</h3>
                        <button type="button" @onclick="() => _showResumeModal = false" class="text-slate-400 hover:text-white">&times;</button>
                    </div>
                    <p class="text-xs text-slate-300">
                        Enter your 8-character Resume Code or the email address used when saving your draft.
                    </p>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-400 mb-1 uppercase">Resume Code</label>
                            <input type="text" @bind="_inputResumeCode" placeholder="e.g. ABC123XYZ"
                                   class="w-full bg-slate-950 border border-white/10 rounded px-3 py-2 text-white font-mono uppercase text-sm" />
                        </div>
                        <div class="text-center text-xs text-slate-500">&mdash; OR &mdash;</div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-400 mb-1 uppercase">Email Address</label>
                            <input type="email" @bind="_inputResumeEmail" placeholder="pastor@example.org"
                                   class="w-full bg-slate-950 border border-white/10 rounded px-3 py-2 text-white text-sm" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_resumeError))
                    {
                        <p class="text-xs text-red-400 font-mono">⚠️ @_resumeError</p>
                    }
                    <div class="pt-2 flex justify-end gap-2">
                        <button type="button" @onclick="() => _showResumeModal = false" class="px-4 py-2 bg-slate-800 text-slate-300 text-xs rounded">Cancel</button>
                        <button type="button" @onclick="ExecuteResumeDraftAsync" class="px-4 py-2 bg-caci-blue hover:bg-caci-tone2 text-white text-xs font-bold uppercase rounded">
                            Load Draft
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- SHARE / SAVE CODE MODAL -->
        @if (_showCodeShareModal)
        {
            <div class="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
                <div class="bg-slate-900 border border-white/10 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
                    <div class="flex items-center justify-between border-b border-white/10 pb-3">
                        <h3 class="text-base font-bold text-white">Draft Saved Successfully</h3>
                        <button type="button" @onclick="() => _showCodeShareModal = false" class="text-slate-400 hover:text-white">&times;</button>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Your application draft has been saved. Use this code to resume on any device:
                    </p>
                    <div class="text-center py-4 bg-slate-950 rounded-xl border border-white/5">
                        <span class="text-2xl font-mono font-bold tracking-widest text-amber-400">@_draftKey</span>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 mb-1 uppercase">Direct Resume Link</label>
                        <input type="text" readonly value="@GetResumeUrl()"
                               class="w-full bg-slate-950 border border-white/10 rounded px-2.5 py-1.5 text-xs font-mono text-emerald-400 select-all" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_data.Email))
                    {
                        <button type="button" @onclick="EmailResumeCodeAsync" disabled="@_isSendingEmail"
                                class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded border border-white/10 transition-colors">
                            @(_isSendingEmail ? "Sending Email..." : $"Email This Code to {_data.Email}")
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(_shareModalMsg))
                    {
                        <p class="text-xs text-emerald-400 text-center font-mono">@_shareModalMsg</p>
                    }
                    <div class="pt-2 flex justify-end">
                        <button type="button" @onclick="() => _showCodeShareModal = false" class="px-5 py-2 bg-caci-blue hover:bg-caci-tone2 text-white text-xs font-bold uppercase rounded">
                            Done
                        </button>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "resume")]
    public string? QueryResumeKey { get; set; }

    private MinisterialApplicationData _data = new();
    private int _recordId = 0;
    private string _draftKey = string.Empty;
    private int _currentStep = 1;
    private int _completionPercentage = 0;
    private List<string> _missingFields = new();
    private bool _isAutosaving;
    private string? _lastSavedTime;
    private bool _isSubmitting;
    private bool _isSubmittedSuccess;

    private bool _showResumeModal;
    private string _inputResumeCode = string.Empty;
    private string _inputResumeEmail = string.Empty;
    private string? _resumeError;

    private bool _showCodeShareModal;
    private bool _isSendingEmail;
    private string? _shareModalMsg;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryResumeKey))
        {
            await LoadDraftByKeyAsync(QueryResumeKey);
        }
        else
        {
            // Check local storage for existing draft
            await LoadFromLocalStorageAsync();
        }
        UpdateCompletionStatus();
    }

    private void UpdateCompletionStatus()
    {
        var result = AppService.CalculateCompletion(_data);
        _completionPercentage = result.Percentage;
        _missingFields = result.MissingFields;
    }

    private async Task TriggerAutoSave()
    {
        UpdateCompletionStatus();
        _isAutosaving = true;
        try
        {
            // 1. Save to local storage
            var json = JsonSerializer.Serialize(_data);
            await JS.InvokeVoidAsync("localStorage.setItem", "caci_minister_app_draft", json);
            if (!string.IsNullOrEmpty(_draftKey))
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "caci_minister_app_key", _draftKey);
            }

            // 2. Persist to DB if applicant has entered at least a name or email
            if (!string.IsNullOrWhiteSpace(_data.FullName) || !string.IsNullOrWhiteSpace(_data.Email))
            {
                var record = await AppService.SaveDraftAsync(_data, _draftKey, _currentStep);
                _recordId = record.Id;
                _draftKey = record.DraftKey;
            }

            _lastSavedTime = DateTime.Now.ToString("h:mm tt");
        }
        catch
        {
            // Silently handle transient auto-save failures
        }
        finally
        {
            _isAutosaving = false;
        }
    }

    private async Task SaveDraftExplicitlyAsync()
    {
        _shareModalMsg = null;
        if (string.IsNullOrWhiteSpace(_data.FullName) && string.IsNullOrWhiteSpace(_data.Email))
        {
            _data.FullName = "Draft Applicant";
        }

        var record = await AppService.SaveDraftAsync(_data, _draftKey, _currentStep);
        _recordId = record.Id;
        _draftKey = record.DraftKey;
        _lastSavedTime = DateTime.Now.ToString("h:mm tt");

        await JS.InvokeVoidAsync("localStorage.setItem", "caci_minister_app_key", _draftKey);
        _showCodeShareModal = true;
    }

    private async Task EmailResumeCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_data.Email) || string.IsNullOrWhiteSpace(_draftKey)) return;
        _isSendingEmail = true;
        try
        {
            await AppService.SendResumeLinkEmailAsync(_data.Email, _draftKey, GetResumeUrl());
            _shareModalMsg = $"Code sent to {_data.Email}!";
        }
        catch (Exception ex)
        {
            _shareModalMsg = $"Error sending email: {ex.Message}";
        }
        finally
        {
            _isSendingEmail = false;
        }
    }

    private string GetResumeUrl() => $"{Navigation.BaseUri.TrimEnd('/')}/ministerial-application?resume={_draftKey}";

    private void OpenResumeModal()
    {
        _inputResumeCode = string.Empty;
        _inputResumeEmail = string.Empty;
        _resumeError = null;
        _showResumeModal = true;
    }

    private async Task ExecuteResumeDraftAsync()
    {
        _resumeError = null;
        MinisterialApplicationRecord? record = null;

        if (!string.IsNullOrWhiteSpace(_inputResumeCode))
        {
            record = await AppService.GetByDraftKeyAsync(_inputResumeCode.Trim());
        }
        else if (!string.IsNullOrWhiteSpace(_inputResumeEmail))
        {
            record = await AppService.GetLatestDraftByEmailAsync(_inputResumeEmail.Trim());
        }
        else
        {
            _resumeError = "Please enter either a resume code or email address.";
            return;
        }

        if (record == null)
        {
            _resumeError = "No matching application draft was found. Please check your code or email.";
            return;
        }

        _recordId = record.Id;
        _draftKey = record.DraftKey;
        _data = record.GetData();
        _currentStep = Math.Clamp(record.CurrentStep, 1, 8);
        UpdateCompletionStatus();

        _showResumeModal = false;
        _lastSavedTime = record.UpdatedAtUtc.ToLocalTime().ToString("h:mm tt");
    }

    private async Task LoadDraftByKeyAsync(string key)
    {
        var record = await AppService.GetByDraftKeyAsync(key);
        if (record != null)
        {
            _recordId = record.Id;
            _draftKey = record.DraftKey;
            _data = record.GetData();
            _currentStep = Math.Clamp(record.CurrentStep, 1, 8);
            _lastSavedTime = record.UpdatedAtUtc.ToLocalTime().ToString("h:mm tt");
        }
    }

    private async Task LoadFromLocalStorageAsync()
    {
        try
        {
            var savedKey = await JS.InvokeAsync<string?>("localStorage.getItem", "caci_minister_app_key");
            if (!string.IsNullOrWhiteSpace(savedKey))
            {
                await LoadDraftByKeyAsync(savedKey);
                return;
            }

            var savedJson = await JS.InvokeAsync<string?>("localStorage.getItem", "caci_minister_app_draft");
            if (!string.IsNullOrWhiteSpace(savedJson))
            {
                var parsed = JsonSerializer.Deserialize<MinisterialApplicationData>(savedJson);
                if (parsed != null)
                {
                    _data = parsed;
                }
            }
        }
        catch
        {
            // Ignore browser storage access failures
        }
    }

    private async Task SubmitApplicationAsync()
    {
        UpdateCompletionStatus();
        if (_missingFields.Count > 0)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            // Ensure record exists
            if (_recordId == 0)
            {
                var record = await AppService.SaveDraftAsync(_data, _draftKey, 8);
                _recordId = record.Id;
                _draftKey = record.DraftKey;
            }

            await AppService.SubmitApplicationAsync(_recordId, _data);
            
            // Clean local storage
            await JS.InvokeVoidAsync("localStorage.removeItem", "caci_minister_app_draft");
            await JS.InvokeVoidAsync("localStorage.removeItem", "caci_minister_app_key");

            _isSubmittedSuccess = true;
        }
        catch (Exception ex)
        {
            _missingFields.Add($"Submission failed: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void GoToStep(int step)
    {
        _currentStep = step;
        UpdateCompletionStatus();
    }

    private void NextStep()
    {
        if (_currentStep < 8)
        {
            _currentStep++;
            _ = TriggerAutoSave();
        }
    }

    private void PrevStep()
    {
        if (_currentStep > 1)
        {
            _currentStep--;
        }
    }

    private string GetStepTitle(int step) => step switch
    {
        1 => "1. Contact",
        2 => "2. Office",
        3 => "3. Family",
        4 => "4. Integrity",
        5 => "5. 4 Keys",
        6 => "6. 4 Pillars",
        7 => "7. Covenant",
        8 => "8. Review",
        _ => ""
    };

    private void ToggleElderQual(string item, bool isChecked)
    {
        if (isChecked && !_data.ElderQualifications.Contains(item))
            _data.ElderQualifications.Add(item);
        else if (!isChecked && _data.ElderQualifications.Contains(item))
            _data.ElderQualifications.Remove(item);
        _ = TriggerAutoSave();
    }

    private string GetReputationValue(string key) => key switch
    {
        "CriminalLitigation" => _data.CriminalLitigation,
        "SexualMisconduct" => _data.SexualMisconduct,
        "PayDebtsTimely" => _data.PayDebtsTimely,
        "CountCostBeforeDebt" => _data.CountCostBeforeDebt,
        "RefrainProfanitySocialMedia" => _data.RefrainProfanitySocialMedia,
        "SecretSocietiesRacistGroups" => _data.SecretSocietiesRacistGroups,
        "ConsentBackgroundCheck" => _data.ConsentBackgroundCheck,
        _ => ""
    };

    private void SetReputationValue(string key, string val)
    {
        switch (key)
        {
            case "CriminalLitigation": _data.CriminalLitigation = val; break;
            case "SexualMisconduct": _data.SexualMisconduct = val; break;
            case "PayDebtsTimely": _data.PayDebtsTimely = val; break;
            case "CountCostBeforeDebt": _data.CountCostBeforeDebt = val; break;
            case "RefrainProfanitySocialMedia": _data.RefrainProfanitySocialMedia = val; break;
            case "SecretSocietiesRacistGroups": _data.SecretSocietiesRacistGroups = val; break;
            case "ConsentBackgroundCheck": _data.ConsentBackgroundCheck = val; break;
        }
        _ = TriggerAutoSave();
    }

    private string GetCovenantValue(string key) => key switch
    {
        "FulfillObligations" => _data.FulfillObligations,
        "DisputeResolutionBiblicalNoLawsuit" => _data.DisputeResolutionBiblicalNoLawsuit,
        "SurrenderCredentialsIfRevoked" => _data.SurrenderCredentialsIfRevoked,
        "AdhereCodeOfEthics" => _data.AdhereCodeOfEthics,
        "BiblicalSubmissionLeadership" => _data.BiblicalSubmissionLeadership,
        "UnityNonFundamentals" => _data.UnityNonFundamentals,
        "UnityRestoredMinisters" => _data.UnityRestoredMinisters,
        "AnnualConvocationParticipation" => _data.AnnualConvocationParticipation,
        "StudyCaciTeachings" => _data.StudyCaciTeachings,
        "CounselBeforePublicDifferenceOrResignation" => _data.CounselBeforePublicDifferenceOrResignation,
        "CounselBeforeAdoptingOutsideDoctrine" => _data.CounselBeforeAdoptingOutsideDoctrine,
        _ => ""
    };

    private void SetCovenantValue(string key, string val)
    {
        switch (key)
        {
            case "FulfillObligations": _data.FulfillObligations = val; break;
            case "DisputeResolutionBiblicalNoLawsuit": _data.DisputeResolutionBiblicalNoLawsuit = val; break;
            case "SurrenderCredentialsIfRevoked": _data.SurrenderCredentialsIfRevoked = val; break;
            case "AdhereCodeOfEthics": _data.AdhereCodeOfEthics = val; break;
            case "BiblicalSubmissionLeadership": _data.BiblicalSubmissionLeadership = val; break;
            case "UnityNonFundamentals": _data.UnityNonFundamentals = val; break;
            case "UnityRestoredMinisters": _data.UnityRestoredMinisters = val; break;
            case "AnnualConvocationParticipation": _data.AnnualConvocationParticipation = val; break;
            case "StudyCaciTeachings": _data.StudyCaciTeachings = val; break;
            case "CounselBeforePublicDifferenceOrResignation": _data.CounselBeforePublicDifferenceOrResignation = val; break;
            case "CounselBeforeAdoptingOutsideDoctrine": _data.CounselBeforeAdoptingOutsideDoctrine = val; break;
        }
        _ = TriggerAutoSave();
    }

    // Static Option Lists matching Google Form 1:1
    private static readonly string[] PresentStatusOptions = new[]
    {
        "I am not affiliated with any organization.",
        "I am seeking to transfer my ministerial credentials from another organization or fellowship to the CACI",
        "I am a member of a CACI congregation applying for ministerial credentials with the CACI",
        "I presently hold ministerial credentials with the CACI and am applying for a different certificate level"
    };

    private static readonly string[] BishopOptions = new[]
    {
        "I have been asked by the CACI Apostolic Council to serve as a Regional Bishop (District Superintendent).",
        "I am presently the Overseer of multiple Congregations, Elders, or Ministries and would like to be considered as a Bishop in Fellowship with the CACI"
    };

    private static readonly string[] ElderOptions = new[]
    {
        "(Pastors) I pastor a local congregation.",
        "(Associate / Assistant Pastor) I am a seasoned minister serving on the pastoral staff.",
        "(Non-Pastoral) I am a seasoned minister who is being recommended to serve as an Elder."
    };

    private static readonly string[] ElderQualificationOptions = new[]
    {
        "I have served no less than two years as a CACI Minister",
        "I am connecting an existing congregation, of which I am Pastor, to the CACI",
        "I have the recommendation and endorsement of my CACI District Bishop"
    };

    private static readonly string[] MinisterOptions = new[]
    {
        "I am serving as a minister in a local assembly and would like to be appointed by the CACI",
        "I would like to begin training for the ministry"
    };

    private static readonly string[] UnderstandingOptions = new[]
    {
        "I fully embrace this Key",
        "I would like more information in this area.",
        "I don't understand this Key to the level to embrace it at this time"
    };

    private static readonly string[] NameViewOptions = new[]
    {
        "I believe the Name must only be spoken in some version of a Hebrew pronunciation. (Yahweh/Yahovah/Yahwah/etc)",
        "I believe the name Jesus is a pagan counterfeit and should be avoided.",
        "I believe that the Name maintains its power even when translated, transliterated, or pronounced in any language."
    };

    private record RepQuestion(string Key, string Question);
    private static readonly RepQuestion[] ReputationQuestions = new[]
    {
        new RepQuestion("CriminalLitigation", "Are you presently in criminal litigation?"),
        new RepQuestion("SexualMisconduct", "Have you ever been convicted of criminal sexual misconduct?"),
        new RepQuestion("PayDebtsTimely", "Do you faithfully pay your debts in a timely manner?"),
        new RepQuestion("CountCostBeforeDebt", "Do you diligently count the cost before making a debt to be sure you have sufficient to finish paying until it is paid in full?"),
        new RepQuestion("RefrainProfanitySocialMedia", "Do you refrain from profanity, and crude humor including posts on social media?"),
