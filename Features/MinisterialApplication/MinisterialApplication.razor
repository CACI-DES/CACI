@page "/ministerial-application"
@page "/apply"
@rendermode InteractiveServer

@using System.Text.Json
@using CACI_Life.Features.MinisterialApplication
@inject MinisterialApplicationService AppService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Ministerial Ordination &amp; Credential Application | CACI</PageTitle>

<div class="bg-slate-900 text-slate-100 min-h-screen py-10 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-4xl mx-auto space-y-8">
        
        <!-- HEADER -->
        <div class="text-center space-y-4 border-b border-white/10 pb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-caci-blue/30 border border-caci-tone2/30 text-caci-tone3 text-xs uppercase tracking-widest font-bold">
                CACI Apostolic Presbytery
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
                Ministerial Ordination &amp; Credential Application
            </h1>
            <p class="text-sm md:text-base text-slate-300 max-w-3xl mx-auto leading-relaxed">
                The CACI Ministerial Ordination is not to be seen as a &ldquo;one-time&rdquo; event but rather a <em>living Covenant</em>. 
                This Apostolic laying on of hands is an ancient Holy Order resting upon generations unbroken from the Eternal Head of the Church, Y&rsquo;shuah Messiah.
            </p>
        </div>

        <!-- SAVE / RESUME FLOATING STATUS BAR -->
        <div class="bg-slate-950/80 border border-white/10 rounded-xl p-4 shadow-xl backdrop-blur flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="space-y-1.5 flex-1 min-w-[200px]">
                <div class="flex items-center justify-between text-xs">
                    <span class="font-bold uppercase tracking-wider text-caci-tone3">Application Progress</span>
                    <span class="font-mono font-bold text-white">@_completionPercentage% Completed</span>
                </div>
                <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-gradient-to-r from-caci-blue to-emerald-500 h-2.5 rounded-full transition-all duration-300" style="width: @(_completionPercentage)%"></div>
                </div>
                <div class="flex items-center gap-2 text-[11px] text-slate-400">
                    @if (_isAutosaving)
                    {
                        <span class="text-caci-tone3 animate-pulse flex items-center gap-1">
                            <svg class="w-3 h-3 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            Saving draft...
                        </span>
                    }
                    else if (!string.IsNullOrEmpty(_lastSavedTime))
                    {
                        <span class="text-emerald-400 flex items-center gap-1">
                            ✓ Saved @(_lastSavedTime)
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(_draftKey))
                    {
                        <span>&bull;</span>
                        <span class="font-mono text-slate-300">Resume Code: <strong class="text-amber-400">@_draftKey</strong></span>
                    }
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" @onclick="OpenResumeModal" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-white/10 transition-colors">
                    Resume Saved Draft
                </button>
                <button type="button" @onclick="SaveDraftExplicitlyAsync" class="px-3.5 py-2 bg-caci-blue hover:bg-caci-tone2 text-white text-xs font-bold uppercase tracking-wider rounded-lg transition-colors shadow">
                    Save &amp; Get Code
                </button>
            </div>
        </div>

        @if (_isSubmittedSuccess)
        {
            <!-- SUBMITTED SUCCESS SCREEN -->
            <div class="bg-slate-950 border border-emerald-500/40 rounded-2xl p-8 sm:p-12 text-center space-y-6 shadow-2xl">
                <div class="w-20 h-20 bg-emerald-500/10 border-2 border-emerald-500 rounded-full flex items-center justify-center mx-auto text-emerald-400">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                </div>
                <h2 class="text-3xl font-extrabold text-white">Application Successfully Submitted</h2>
                <p class="text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
                    Thank you, <strong class="text-white">@_data.FullName</strong>. Your CACI Ministerial Credential Application has been formally submitted to the Apostolic Council and Credential Committee.
                </p>
                <div class="bg-slate-900 border border-white/10 rounded-xl p-5 max-w-md mx-auto text-left text-xs space-y-2 font-mono">
                    <div><span class="text-slate-400">Applicant:</span> <span class="text-white font-bold">@_data.FullName</span></div>
                    <div><span class="text-slate-400">Target Office:</span> <span class="text-emerald-400 font-bold">@_data.CredentialLevelApplyingFor</span></div>
                    <div><span class="text-slate-400">Submission Date:</span> <span class="text-slate-300">@DateTime.UtcNow.ToString("MMMM dd, yyyy HH:mm") UTC</span></div>
                    <div><span class="text-slate-400">Email Confirmation Sent To:</span> <span class="text-amber-300 font-bold">@_data.Email</span></div>
                </div>
                <p class="text-xs text-slate-400">
                    A copy of your submission has been emailed to you. The CACI leadership team will review your application and reach out regarding next steps.
                </p>
                <div class="pt-4 flex flex-wrap justify-center gap-4">
                    <button type="button" onclick="window.print()" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold uppercase tracking-wider rounded-lg border border-white/10 transition-all">
                        Print Confirmation
                    </button>
                    <a href="/" class="px-6 py-2.5 bg-caci-blue hover:bg-caci-tone2 text-white text-xs font-bold uppercase tracking-wider rounded-lg transition-all shadow">
                        Return to Home
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- STEPPER NAV -->
            <div class="overflow-x-auto pb-2">
                <div class="flex items-center justify-between min-w-[700px] border-b border-white/10 pb-3">
                    @for (int i = 1; i <= 8; i++)
                    {
                        var stepNum = i;
                        var isCurrent = _currentStep == stepNum;
                        var isPast = _currentStep > stepNum;
                        <button type="button" @onclick="() => GoToStep(stepNum)"
                                class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider transition-colors px-2 py-1 rounded @(isCurrent ? "text-caci-tone3 font-bold bg-white/5" : (isPast ? "text-emerald-400 hover:text-white" : "text-slate-500 hover:text-slate-300"))">
                            <span class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-mono font-bold @(isCurrent ? "bg-caci-blue text-white" : (isPast ? "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" : "bg-slate-800 text-slate-400"))">
                                @(isPast ? "✓" : stepNum.ToString())
                            </span>
                            <span>@GetStepTitle(stepNum)</span>
                        </button>
                        @if (i < 8)
                        {
                            <span class="text-slate-700">&bull;</span>
                        }
                    }
                </div>
            </div>

            <!-- STEP CONTENT CARDS -->
            <div class="bg-slate-950 border border-white/10 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">

                <!-- STEP 1: PERSONAL & CONTACT -->
                @if (_currentStep == 1)
                {
                    <div class="space-y-6">
                        <div class="border-b border-white/10 pb-3">
                            <h2 class="text-xl font-bold text-white">Stage 1: Applicant Information</h2>
                            <p class="text-xs text-slate-400 mt-1">Please provide your legal contact details for credential records.</p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Your Full Name *</label>
                                <input type="text" @bind="_data.FullName" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="First Middle Last"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-sm focus:outline-none focus:border-caci-tone2" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Phone Number *</label>
                                <input type="tel" @bind="_data.Phone" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="(555) 123-4567"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-sm focus:outline-none focus:border-caci-tone2" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Date of Birth *</label>
                                <input type="date" value="@_data.DateOfBirth" @onchange="@((ChangeEventArgs e) => { _data.DateOfBirth = e.Value?.ToString() ?? string.Empty; TriggerAutoSave(); })"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-sm focus:outline-none focus:border-caci-tone2" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Email Address *</label>
                                <input type="email" @bind="_data.Email" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="pastor@example.org"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-sm focus:outline-none focus:border-caci-tone2" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Street Address *</label>
                                <input type="text" @bind="_data.StreetAddress" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="123 Kingdom Way"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-sm focus:outline-none focus:border-caci-tone2" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">City / State / Zip *</label>
                                <input type="text" @bind="_data.CityStateZip" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="Springfield, MO 65802"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-sm focus:outline-none focus:border-caci-tone2" />
                            </div>
                        </div>
                    </div>
                }

                <!-- STEP 2: CREDENTIAL LEVEL & OFFICE -->
                @if (_currentStep == 2)
                {
                    <div class="space-y-6">
                        <div class="border-b border-white/10 pb-3">
                            <h2 class="text-xl font-bold text-white">Stage 2: Credential Certificate Level</h2>
                            <p class="text-xs text-slate-300 mt-1 leading-relaxed">
                                The CACI Ministry recognizes the three first-century offices of <strong>Bishops</strong> (Regional Superintendents), <strong>Ordained Elders</strong> (Local Pastors &amp; Sr. Ministry), and <strong>Appointed Ministers</strong> (Assistants &amp; Diakonia).
                            </p>
                        </div>

                        <!-- Present Status -->
                        <div>
                            <label class="block text-xs font-bold text-caci-tone3 mb-2 uppercase tracking-wider">Present Ministerial Status *</label>
                            <div class="space-y-2">
                                @foreach (var opt in PresentStatusOptions)
                                {
                                    <label class="flex items-start gap-3 p-3 rounded-lg border @(_data.PresentMinisterialStatus == opt ? "border-caci-tone2 bg-caci-blue/20" : "border-white/5 bg-slate-900/60 hover:bg-slate-900") cursor-pointer transition">
                                        <input type="radio" name="presentStatus" value="@opt" checked="@(_data.PresentMinisterialStatus == opt)"
                                               @onchange="() => { _data.PresentMinisterialStatus = opt; TriggerAutoSave(); }" class="mt-0.5 text-caci-blue" />
                                        <span class="text-xs text-slate-200">@opt</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Certificate Level Target -->
                        <div>
                            <label class="block text-xs font-bold text-caci-tone3 mb-2 uppercase tracking-wider">Credential Level Applying For *</label>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                @foreach (var lvl in new[] { "Bishop", "Ordained Elder", "Appointed Minister" })
                                {
                                    <button type="button" @onclick="() => { _data.CredentialLevelApplyingFor = lvl; TriggerAutoSave(); }"
                                            class="p-4 rounded-xl border text-center transition-all @(_data.CredentialLevelApplyingFor == lvl ? "border-caci-tone2 bg-caci-blue/30 text-white font-bold ring-2 ring-caci-tone2" : "border-white/10 bg-slate-900/80 text-slate-300 hover:bg-slate-900")">
                                        <div class="text-sm font-bold uppercase tracking-wider">@lvl</div>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Bishop Details if selected -->
                        @if (_data.CredentialLevelApplyingFor == "Bishop")
                        {
                            <div class="bg-purple-950/30 border border-purple-500/30 rounded-xl p-5 space-y-3">
                                <h3 class="text-xs font-bold uppercase tracking-widest text-purple-300">Bishop (District or Regional Overseer) Criteria</h3>
                                <p class="text-xs text-slate-300 leading-relaxed">
                                    You may only apply as a Bishop at the request of the CACI Apostolic Council. Bishops are consecrated by the laying on of hands of no less than two CACI Bishops in Apostolic Succession.
                                </p>
                                <div class="space-y-2 pt-2">
                                    @foreach (var opt in BishopOptions)
                                    {
                                        <label class="flex items-start gap-3 p-2.5 rounded border border-white/5 bg-slate-900 cursor-pointer">
                                            <input type="radio" name="bishopOpt" value="@opt" checked="@(_data.BishopOption == opt)"
                                                   @onchange="() => { _data.BishopOption = opt; TriggerAutoSave(); }" class="mt-0.5" />
                                            <span class="text-xs text-slate-200">@opt</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Elder Details if selected -->
                        @if (_data.CredentialLevelApplyingFor == "Ordained Elder")
                        {
                            <div class="bg-amber-950/30 border border-amber-500/30 rounded-xl p-5 space-y-4">
                                <h3 class="text-xs font-bold uppercase tracking-widest text-amber-300">Ordained Elder (Congregational Overseers) Criteria</h3>
                                <p class="text-xs text-slate-300 leading-relaxed">
                                    You may only apply as an Elder after serving two years as a CACI Minister, or when connecting an existing Congregation of which you are Pastor, with the endorsement of your CACI District Bishop.
                                </p>
                                <div class="space-y-2">
                                    <label class="block text-[11px] font-bold text-amber-200 uppercase">Select Role Type:</label>
                                    @foreach (var opt in ElderOptions)
                                    {
                                        <label class="flex items-start gap-3 p-2.5 rounded border border-white/5 bg-slate-900 cursor-pointer">
                                            <input type="radio" name="elderOpt" value="@opt" checked="@(_data.ElderOption == opt)"
                                                   @onchange="() => { _data.ElderOption = opt; TriggerAutoSave(); }" class="mt-0.5" />
                                            <span class="text-xs text-slate-200">@opt</span>
                                        </label>
                                    }
                                </div>
                                <div class="space-y-2 pt-2">
                                    <label class="block text-[11px] font-bold text-amber-200 uppercase">Check All That Apply:</label>
                                    @foreach (var q in ElderQualificationOptions)
                                    {
                                        var isChecked = _data.ElderQualifications.Contains(q);
                                        <label class="flex items-start gap-3 p-2 rounded bg-slate-900/60 cursor-pointer text-xs">
                                            <input type="checkbox" checked="@isChecked"
                                                   @onchange="(e) => ToggleElderQual(q, (bool?)e.Value ?? false)" class="rounded mt-0.5" />
                                            <span class="text-slate-200">@q</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Minister Details if selected -->
                        @if (_data.CredentialLevelApplyingFor == "Appointed Minister")
                        {
                            <div class="bg-blue-950/30 border border-blue-500/30 rounded-xl p-5 space-y-3">
                                <h3 class="text-xs font-bold uppercase tracking-widest text-blue-300">Appointed Minister Criteria</h3>
                                <p class="text-xs text-slate-300 leading-relaxed">
                                    For those working with their local Bishop/Eldership in areas such as house church, small group, men's, women's, youth, music, prison ministry, or beginning ministry training.
                                </p>
                                <div class="space-y-2 pt-1">
                                    @foreach (var opt in MinisterOptions)
                                    {
                                        <label class="flex items-start gap-3 p-2.5 rounded border border-white/5 bg-slate-900 cursor-pointer">
                                            <input type="radio" name="minOpt" value="@opt" checked="@(_data.MinisterOption == opt)"
                                                   @onchange="() => { _data.MinisterOption = opt; TriggerAutoSave(); }" class="mt-0.5" />
                                            <span class="text-xs text-slate-200">@opt</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 pt-2">
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Length in Present Ministry *</label>
                                <input type="text" @bind="_data.PresentMinistryDuration" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="e.g. 3 years"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-xs focus:outline-none focus:border-caci-tone2" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Pastor's Name *</label>
                                <input type="text" @bind="_data.PastorName" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="e.g. Elder John Smith"
                                       class="w-full bg-slate-900 border border-white/10 rounded-lg px-3.5 py-2.5 text-white text-xs focus:outline-none focus:border-caci-tone2" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-caci-tone3 mb-1.5 uppercase tracking-wider">Is Pastor Supportive? *</label>
                                <select @bind="_data.PastorSupport" @bind:after="TriggerAutoSave"
                                        class="w-full bg-slate-900 border border-white/10 rounded-lg px-3 py-2.5 text-white text-xs focus:outline-none focus:border-caci-tone2">
                                    <option value="">-- Choose Option --</option>
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                    <option value="I am uncertain">I am uncertain</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }

                <!-- STEP 3: FAMILY & CONVERSION -->
                @if (_currentStep == 3)
                {
                    <div class="space-y-6">
                        <div class="border-b border-white/10 pb-3">
                            <h2 class="text-xl font-bold text-white">Stage 3: Family Status &amp; Conversion Experience</h2>
                            <p class="text-xs text-slate-400 mt-1">Biblical standards of family life and the New Testament conversion experience.</p>
                        </div>

                        <!-- Family -->
                        <div class="space-y-4">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-caci-tone3">Family Status</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Marital Status *</label>
                                    <select @bind="_data.MaritalStatus" @bind:after="TriggerAutoSave"
                                            class="w-full bg-slate-900 border border-white/10 rounded px-3 py-2 text-white text-xs">
                                        <option value="">-- Select --</option>
                                        <option value="Single">Single</option>
                                        <option value="Married">Married</option>
                                        <option value="Widowed">Widowed</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Spouse Name (if married)</label>
                                    <input type="text" @bind="_data.SpouseName" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="Spouse's Name"
                                           class="w-full bg-slate-900 border border-white/10 rounded px-3 py-2 text-white text-xs" />
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Anniversary (if married)</label>
                                    <input type="text" @bind="_data.AnniversaryDate" @bind:event="oninput" @bind:after="TriggerAutoSave" placeholder="MM/DD/YYYY"
                                           class="w-full bg-slate-900 border border-white/10 rounded px-3 py-2 text-white text-xs" />
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Spouse Supportive?</label>
                                    <select @bind="_data.SpouseSupportive" @bind:after="TriggerAutoSave"
                                            class="w-full bg-slate-900 border border-white/10 rounded px-3 py-2 text-white text-xs">
                                        <option value="">-- Select --</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Conversion -->
                        <div class="space-y-4 pt-4 border-t border-white/10">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-caci-tone3">Conversion Experience</h3>

                            <div class="space-y-2">
                                <label class="block text-xs text-slate-200 font-semibold leading-relaxed">
                                    Have you experienced the Bible standard of full conversion through repentance from sin, baptism in water by immersion in the name of the Lord Jesus Christ for the remission of sins, and the New Testament Baptism of the Holy Spirit with scriptural signs and manifestations? (Acts 2:38, 1 Cor 12:7-11, Gal 5:22) *
                                </label>
                                <div class="flex gap-4">
                                    @foreach (var opt in new[] { "Yes", "No" })
                                    {
                                        <label class="inline-flex items-center gap-2 text-xs text-white cursor-pointer">
                                            <input type="radio" name="actsConv" value="@opt" checked="@(_data.Acts238Standard == opt)"
                                                   @onchange="() => { _data.Acts238Standard = opt; TriggerAutoSave(); }" />
                                            <span>@opt</span>
                                        </label>
                                    }
                                </div>
                            </div>

                            <div class="space-y-2 pt-2">
                                <label class="block text-xs text-slate-200 font-semibold leading-relaxed">
                                    Were you fully immersed in water exclusively in the Name of Jesus Christ (or its linguistic equivalent)? *
                                </label>
                                <div class="flex gap-4">
                                    @foreach (var opt in new[] { "Yes", "No", "I am not sure" })
                                    {
                                        <label class="inline-flex items-center gap-2 text-xs text-white cursor-pointer">
                                            <input type="radio" name="waterBap" value="@opt" checked="@(_data.WaterBaptismJesusName == opt)"
                                                   @onchange="() => { _data.WaterBaptismJesusName = opt; TriggerAutoSave(); }" />
                                            <span>@opt</span>
                                        </label>
                                    }
                                </div>
                            </div>

                            <div class="space-y-2 pt-2">
                                <label class="block text-xs text-slate-200 font-semibold leading-relaxed">
                                    Have you received the infilling of the Holy Spirit with initial evidence of speaking in tongues as the Spirit gives the utterance? *
                                </label>
                                <div class="flex gap-4">
                                    @foreach (var opt in new[] { "Yes", "No", "I am not sure." })
                                    {
                                        <label class="inline-flex items-center gap-2 text-xs text-white cursor-pointer">
                                            <input type="radio" name="holySpir" value="@opt" checked="@(_data.HolySpiritTonguesEvidence == opt)"
