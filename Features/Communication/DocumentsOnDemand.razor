@page "/documents-on-demand"
@using CACI_Life.Features.SiteMedia
@inject ISiteMediaService SiteMedia

<SeoHead Title="CACI - Documents on Demand"
         Description="Download official CACI documents and letters, including the Festival Letter and Sabbath Letter."
         CanonicalUrl="https://caci.life/documents-on-demand" />

<section class="section-padding">
    <div class="container">
        <div class="section-header">
            <h1>Documents on Demand</h1>
            <div class="divider"></div>
            <p>Access and download official documents and letters from Covenant Apostolic Congregations International.</p>
        </div>

        <div class="documents-grid">
            <!-- Festival Letter -->
            <a href="Festival%20Letter.pdf" class="document-card" download>
                <div class="card-image-wrapper">
                    <img src="@SiteMediaHelper.GetUrl(_media, SiteMediaKeys.DocumentsFestivalLetterThumb)" alt="@SiteMediaHelper.GetAlt(_media, SiteMediaKeys.DocumentsFestivalLetterThumb)" onerror="@SiteMediaHelper.GetImageOnError(SiteMediaKeys.DocumentsFestivalLetterThumb)" class="card-image">
                </div>
                <div class="card-content">
                    <h3 class="card-title">Festival Letter</h3>
                    <p class="card-description">Official letter regarding the appointed festivals.</p>
                    <div class="card-btn">
                        Download PDF <i class="fas fa-download"></i>
                    </div>
                </div>
            </a>

            <!-- Sabbath Letter -->
            <a href="Sabbath%20Letter.pdf" class="document-card" download>
                <div class="card-image-wrapper">
                    <img src="@SiteMediaHelper.GetUrl(_media, SiteMediaKeys.DocumentsSabbathLetterThumb)" alt="@SiteMediaHelper.GetAlt(_media, SiteMediaKeys.DocumentsSabbathLetterThumb)" onerror="@SiteMediaHelper.GetImageOnError(SiteMediaKeys.DocumentsSabbathLetterThumb)" class="card-image">
                </div>
                <div class="card-content">
                    <h3 class="card-title">Sabbath Letter</h3>
                    <p class="card-description">Official letter regarding the Sabbath observance.</p>
                    <div class="card-btn">
                        Download PDF <i class="fas fa-download"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

@code {
    private IReadOnlyDictionary<string, SiteMediaItem> _media =
        new Dictionary<string, SiteMediaItem>(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _media = await SiteMedia.GetAllAsync();
    }
}
