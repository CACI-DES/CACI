@page "/study-with-us"

<SeoHead Title="CACI - Study With Us"
         Description="Join our Bible studies, learn the 4 Kingdom Keys, explore the 12 Foundations, and discover the 4 Pillars of Apostolic Faith."
         CanonicalUrl="https://caci.life/study-with-us" />

<section class="section-padding">
    <div class="container">
        <div class="section-header">
            <h1>Study With Us</h1>
            <div class="divider"></div>
            <p>Deepen your understanding of Scripture and the Apostolic Faith with these study resources.</p>
        </div>

        <div class="study-grid">
            <!-- 1. BiWeekly Bible Study -->
            <a href="https://youtube.com/@@covenantapostoliccongregations" target="_blank" class="study-card">
               
                <div class="card-image-wrapper">
                    <!-- Placeholder placeholder for "Online Bible Study" -->
                    <img src="images/images/OnlineBibleStudy.jpg" alt="Bible Study" class="card-image">
                </div>                
                <div class="card-content">
                    <h3 class="card-title">Join us for BiWeekly Bible Study</h3>
                    <p class="card-description">Connect with us live or watch past streams as we dive deep into the Word of God every other week.</p>
                    <div class="card-btn">
                        Watch Online <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- 2. 4 Keys of the Coming Kingdom -->
            <a href="4KeysInfo" class="study-card">
                <div class="custom-card-header">
                    <div class="blue-bar"></div>
                    <div class="header-top-text">Our Message</div>
                    <div class="header-logo-container">
                        <img src="images/logos/AllTheWord_TextLogo.png" alt="CACI Logo" class="header-logo">
                    </div>
                    <div class="header-main-title">The Coming Kingdom</div>
                    <div class="header-sub-title">4 Keys</div>
                    <div class="blue-bar"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">4 Keys of the Coming Kingdom</h3>
                    <p class="card-description">Discover the 4 keys to understanding the Coming Kingdom of God: The Coming Kingdom, The Law of the Kingdom, The Culture of the Kingdom , and The Gospel of the Kingdom.</p>
                    <div class="card-btn">
                        Learn More <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- 3. 12 Foundations -->
            <a href="12Foundations" class="study-card">
                <div class="custom-card-header">
                    <div class="blue-bar"></div>
                    <div class="header-top-text">Our Doctrine</div>
                    <div class="header-logo-container">
                        <img src="images/logos/AllTheWord_TextLogo.png" alt="CACI Logo" class="header-logo">
                    </div>
                    <div class="header-main-title">Understanding Your Bible</div>
                    <div class="header-sub-title">12 Foundations</div>
                    <div class="blue-bar"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">12 Foundations to Understanding Your Bible</h3>
                    <p class="card-description">Build your faith on a solid rock. Explore the twelve fundamental doctrines that anchor our beliefs.</p>
                    <div class="card-btn">
                        Start Study <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- 4. 4 Pillars of Apostolic Faith -->
            <a href="4PillarsInfo" class="study-card">
                <div class="custom-card-header">
                    <div class="blue-bar"></div>
                    <div class="header-top-text">Our Mission</div>
                    <div class="header-logo-container">
                        <img src="images/logos/AllTheWord_TextLogo.png" alt="CACI Logo" class="header-logo">
                    </div>
                    <div class="header-main-title">Apostolic Faith</div>
                    <div class="header-sub-title">4 Pillars</div>
                    <div class="blue-bar"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title"><span style="font-weight: 700; font-size: 1.8rem;">4</span> Pillars of Apostolic Faith</h3>
                    <p class="card-description">The Apostoles Doctrine, Fellowship, Breaking of Bread, and Prayers. The structure of the early church. (Acts 2:42)</p>
                    <div class="card-btn">
                        Read More <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>
