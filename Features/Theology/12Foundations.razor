@page "/12Foundations"
@page "/foundations"

<div class="caci-announcement-strip bg-gradient-to-r from-[#001438] via-[#001F5C] to-[#0A2E6E] text-white py-3.5 px-4 sm:px-6 lg:px-8 border-b border-[#174477]/80 shadow-sm">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
        <div class="flex flex-col sm:flex-row items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-[#C8102E] text-white shadow-sm ring-1 ring-white/20 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                Open Discipleship
            </span>
            <span class="text-xs sm:text-sm text-slate-100 font-medium leading-relaxed">
                Foundations 1–3 are open for self-paced online study. Connect with an elder for in-person discipleship on Foundations 4–12.
            </span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2.5 shrink-0">
            <a href="/foundations/lesson/1" 
               class="inline-flex items-center px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-[#C8102E] hover:bg-[#A60D25] text-white shadow hover:shadow-md transition-all group">
                <span>Start Lesson 1 Online</span>
                <svg class="w-3.5 h-3.5 ml-1.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
            </a>
            <a href="/portal/foundations" 
               class="inline-flex items-center px-3.5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-white/10 hover:bg-white/20 text-[#A4BDDD] hover:text-white border border-white/20 transition-all">
                <svg class="w-3.5 h-3.5 mr-1.5 text-[#A4BDDD]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <span>Minister Portal</span>
            </a>
        </div>
    </div>
</div>

<DoctrinalFunnelEngine Config="@FunnelPresets.Get12FoundationsConfig()" />
