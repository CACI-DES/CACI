@using CACI.Core.Domain.Funnels
@inject ISubsiteContext SubsiteContext
@inject NavigationManager Navigation

<!-- Top Bar matching CACI Minister Blue theme -->
<div class="bg-[#001F5C] text-white py-1.5 px-4 text-xs font-medium hidden sm:block">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <span>Covenant Apostolic Congregations International</span>
        <span class="tracking-wider uppercase text-[#A4BDDD] font-semibold">"All The Word To All The World"</span>
    </div>
</div>

<header class="site-header bg-white border-b border-[#E2E8F0] sticky top-0 z-50 shadow-sm text-[#333333]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Brand & Subsite Identity -->
        <a href="/" class="flex items-center space-x-3 group">
            <img src="images/logos/AllTheWord_NOTextLogo.png" alt="CACI Logo" class="h-10 w-auto transition-transform duration-300 group-hover:scale-105" />
            <div class="flex flex-col">
                <div class="flex items-center space-x-2">
                    <span class="text-xl font-bold tracking-tight text-[#001F5C]">CACI</span>
                    <span class="text-xs font-mono font-bold uppercase px-2 py-0.5 rounded bg-[#EBF2FA] text-[#174477] border border-[#A4BDDD]">
                        @SubsiteContext.SubsiteBadge
                    </span>
                </div>
                <span class="text-[11px] text-[#5A5A5A] font-semibold tracking-wide" style="font-family: var(--font-body, 'Montserrat', sans-serif);">
                    @SubsiteContext.SubsiteName
                </span>
            </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center space-x-8">
            <a href="#explore" class="text-sm font-bold text-[#333333] hover:text-[#174477] transition-colors">
                Explore Blueprint
            </a>
            <a href="#faq" class="text-sm font-bold text-[#333333] hover:text-[#174477] transition-colors">
                FAQ
            </a>
            <a href="https://caci.life/study-with-us" target="_blank" class="text-sm font-bold text-[#333333] hover:text-[#174477] transition-colors">
                All Bible Studies
            </a>
            <a href="https://caci.life" target="_blank" class="text-sm font-semibold text-[#64748B] hover:text-[#174477] transition-colors flex items-center">
                <span>caci.life</span>
                <svg class="w-3.5 h-3.5 ml-1 text-[#64748B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
            </a>
        </nav>

        <!-- Right CTA Button -->
        <div class="hidden sm:flex items-center space-x-4">
            <a href="@GetRequestStudyUrl()" 
               class="inline-flex items-center px-5 py-2.5 rounded-md text-xs font-bold uppercase tracking-wider bg-[#174477] hover:bg-[#6696C5] text-white transition-all shadow-md hover:shadow-lg">
                <span>Request Guided Study</span>
                <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <div class="md:hidden flex items-center">
            <button type="button" @onclick="ToggleMobileMenu" class="text-[#001F5C] hover:text-[#174477] p-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    @if (isMobileMenuOpen)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    }
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu Drawer -->
    @if (isMobileMenuOpen)
    {
        <div class="md:hidden bg-white border-b border-[#E2E8F0] px-4 pt-3 pb-6 space-y-3">
            <a href="#explore" @onclick="CloseMobileMenu" class="block text-sm font-bold text-[#333333] hover:text-[#174477] py-2">
                Explore Blueprint
            </a>
            <a href="#faq" @onclick="CloseMobileMenu" class="block text-sm font-bold text-[#333333] hover:text-[#174477] py-2">
                FAQ
            </a>
            <a href="https://caci.life/study-with-us" target="_blank" class="block text-sm font-bold text-[#333333] hover:text-[#174477] py-2">
                All Bible Studies
            </a>
            <a href="https://caci.life" target="_blank" class="block text-sm font-semibold text-[#64748B] hover:text-[#174477] py-2">
                Main CACI Life Website &rarr;
            </a>
            <div class="pt-2">
                <a href="@GetRequestStudyUrl()" 
                   class="flex items-center justify-center w-full px-4 py-3 rounded-md text-xs font-bold uppercase tracking-wider bg-[#174477] text-white">
                    Request Guided Study
                </a>
            </div>
        </div>
    }
</header>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private string GetRequestStudyUrl()
    {
        var funnelId = SubsiteContext.Configuration?.FunnelId ?? "subsite";
        return $"https://caci.life/request-bible-study?key={Uri.EscapeDataString(funnelId)}";
    }
}
