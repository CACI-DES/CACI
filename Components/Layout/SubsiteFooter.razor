@using CACI.Core.Domain.Funnels
@inject ISubsiteContext SubsiteContext

<footer class="bg-[#001F5C] text-white pt-12 pb-6 border-t-4 border-[#C8102E]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Motto Banner -->
        <p class="text-center font-bold uppercase tracking-widest text-white/90 text-sm mb-10" style="font-family: var(--font-body, 'Montserrat', sans-serif);">
            "All The Word To All The World"
        </p>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-white/10 text-sm">
            <!-- Brand Column -->
            <div class="space-y-3">
                <div class="flex items-center space-x-3">
                    <img src="images/logos/AllTheWord_NOTextLogo.png" alt="CACI Logo" class="h-9 w-auto" />
                    <span class="text-xl font-bold tracking-tight text-white">CACI</span>
                </div>
                <p class="text-xs text-white/80 leading-relaxed">
                    Covenant Apostolic Congregations Intl.<br />
                    An Apostolic fellowship dedicated to restore the original Apostolic faith.
                </p>
                <span class="inline-block text-xs font-mono px-2 py-0.5 rounded bg-white/10 text-[#A4BDDD] border border-white/20">
                    @SubsiteContext.SubsiteBadge
                </span>
            </div>

            <!-- Quick Links -->
            <div>
                <h4 class="text-sm font-bold uppercase tracking-wider text-[#A4BDDD] mb-4">
                    Thematic Funnels
                </h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="https://4keys.caci.life" class="text-white/80 hover:text-white transition-colors">The 4 Keys of the Kingdom</a></li>
                    <li><a href="https://caci.life/pillars" class="text-white/80 hover:text-white transition-colors">The 4 Pillars of Faith</a></li>
                    <li><a href="https://caci.life/foundations" class="text-white/80 hover:text-white transition-colors">The 12 Foundations</a></li>
                    <li><a href="https://caci.life/study-with-us" class="text-white/80 hover:text-white transition-colors">All Bible Studies</a></li>
                </ul>
            </div>

            <!-- Doctrine & Observance -->
            <div>
                <h4 class="text-sm font-bold uppercase tracking-wider text-[#A4BDDD] mb-4">
                    Faith & Practice
                </h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="https://caci.life/what-we-believe" class="text-white/80 hover:text-white transition-colors">What We Believe</a></li>
                    <li><a href="https://caci.life/sabbath" class="text-white/80 hover:text-white transition-colors">The 7th-Day Sabbath</a></li>
                    <li><a href="https://caci.life/feast-dates" class="text-white/80 hover:text-white transition-colors">Biblical Feasts</a></li>
                    <li><a href="https://caci.life/our-history" class="text-white/80 hover:text-white transition-colors">Our History</a></li>
                </ul>
            </div>

            <!-- Connect & Guided Study -->
            <div>
                <h4 class="text-sm font-bold uppercase tracking-wider text-[#A4BDDD] mb-4">
                    Connect
                </h4>
                <p class="text-xs text-white/80 mb-3">
                    9777 Betty's Way Suite C<br />
                    Semmes, AL 36575
                </p>
                <div class="mb-4">
                    <a href="https://caci.life/request-bible-study" class="inline-block text-xs font-bold uppercase tracking-wider bg-[#C8102E] hover:bg-[#a50d25] text-white px-3 py-1.5 rounded transition-colors shadow">
                        Request Guided Study &rarr;
                    </a>
                </div>
                <div class="flex space-x-3 text-lg text-white/80">
                    <a href="https://www.facebook.com/THECACI" target="_blank" class="hover:text-white"><i class="fab fa-facebook"></i></a>
                    <a href="https://www.youtube.com/@@covenantapostoliccongregations" target="_blank" class="hover:text-white"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="pt-6 text-center text-xs text-white/60 space-y-2">
            <p>&copy; @DateTime.UtcNow.Year CACI. All Rights Reserved. | <a href="https://caci.life" class="hover:underline text-white/80">Covenant Apostolic Congregations International</a></p>
            <p style="font-size: 11px; color: #a0aec0;">
                If you have any issues with this site or need assistance please contact Elder Dave Seibold at 
                <a href="mailto:D.SEIBOLD@@CACI.Life" style="color: #ecc94b; text-decoration: underline;">D.SEIBOLD@@CACI.Life</a>
            </p>
        </div>
    </div>
</footer>
