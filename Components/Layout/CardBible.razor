<style>
    .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        margin: auto;
    }

    .card-img img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    @@media (min-width: 768px) {
        .card-img img {
            height: 325px;
        }
    }

    .card-title {
        font-size: 1.5rem;
        margin-bottom: 10px;
        color: var(--minister-blue);
    }

    .card-text {
        font-size: 1rem;
        color: #555;
        text-align: left;
    }

    .card-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 15px;
        background-color: #f8f8f8;
    }

    .card-footer a {
       margin:0;
       padding:0;
    }

    .card-footer img {
        width: 100%;
        height: auto;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }
    
    .image-container {
        width: 64px;
        height: 64px;
        transition: transform 0.2s ease;
    }

    .image-container:hover {
        transform: scale(1.08);
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

</style>

<div class="card">
    <div class="card-img @BackgroundColor">@Image</div>
    <div class="card-body">
        <h3 class="card-title">@Title</h3>
        <p class="card-text">@Text</p>
    </div>
    <div class="card-footer">
        @Links
    </div>
</div>


@code {
    [Parameter]
    public RenderFragment Image { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment Text { get; set; } = default!;

    [Parameter]
    public RenderFragment Links { get; set; } = default!;

    [Parameter]
    public string BackgroundColor { get; set; } = string.Empty;
}