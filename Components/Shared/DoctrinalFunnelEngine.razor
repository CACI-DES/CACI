@using System.Text.Json
@using CACI.Core.Domain.Funnels
@inject NavigationManager NavigationManager

@if (Config != null)
{
    <PageTitle>@Config.MainTitle - CACI</PageTitle>

    <!-- Complete SEO Meta Tags, Social Previews & In-Page Structured Data -->
    <HeadContent>
        <link rel="canonical" href="@Config.CanonicalUrl" />
        <meta name="description" content="@Config.SubtitleLead" />
        @if (!string.IsNullOrEmpty(Config.Keywords))
        {
            <meta name="keywords" content="@Config.Keywords" />
        }
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Covenant Apostolic Congregations International" />
        <meta property="og:url" content="@Config.CanonicalUrl" />
        <meta property="og:title" content="@($"{Config.MainTitle} | CACI")" />
        <meta property="og:description" content="@Config.SubtitleLead" />
        <meta property="og:image" content="@Config.OgImageUrl" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@@THECACI" />
        <meta name="twitter:url" content="@Config.CanonicalUrl" />
        <meta name="twitter:title" content="@($"{Config.MainTitle} | CACI")" />
        <meta name="twitter:description" content="@Config.SubtitleLead" />
        <meta name="twitter:image" content="@Config.OgImageUrl" />

        <!-- Schema.org Dynamic JSON-LD -->
        <script type="application/ld+json">
            @((MarkupString)GenerateJsonLd())
        </script>
    </HeadContent>

    <div class="caci-funnel-engine min-h-screen bg-[#F8FAFC] text-[#333333] font-sans antialiased pb-20">
        
        <!-- CACI Hero Section (Non-sticky static section) -->
        <section class="caci-funnel-hero relative bg-gradient-to-b from-[#EBF2FA] via-[#F4F7FB] to-[#F8FAFC] border-b border-[#E2E8F0] pt-12 pb-12 sm:pt-14 sm:pb-14 text-center px-4 sm:px-6 lg:px-8">
            <div class="max-w-5xl mx-auto">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase bg-white text-[#174477] border border-[#CBD5E1] mb-4 shadow-sm">
                    <svg class="w-3.5 h-3.5 text-[#174477]" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
                    </svg>
                    @Config.CategoryBadge
                </span>
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#001F5C] mb-4 leading-tight" style="font-family: var(--font-heading, 'Playfair Display', Georgia, serif);">
                    @Config.MainTitle
                </h1>
                <div class="divider mx-auto mb-6" style="height: 4px; width: 80px; background-color: var(--bishop-purple, #47306D); border-radius: 2px;"></div>
                <p class="text-base sm:text-lg text-[#5A5A5A] max-w-3xl mx-auto leading-relaxed" style="font-family: var(--font-body, 'Montserrat', sans-serif);">
                    @Config.SubtitleLead
                </p>
            </div>
        </section>

        <!-- Dynamic Grid of Pillars / Keys / Foundations -->
        <main id="explore" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 scroll-mt-24">
            <div class="grid @Config.GridColumnsClass gap-8 items-start">
                @foreach (var item in Config.Items)
                {
                    var isExpanded = activeItemId == item.Order;
                    var hasInteractiveLesson = Config.FunnelId == "12foundations" && item.Order <= 3;
                    <div id="@item.Slug" 
                         class="rounded-xl border transition-all duration-300 overflow-hidden bg-white shadow-md hover:shadow-xl scroll-mt-24 @(isExpanded ? "border-[#174477] ring-2 ring-[#174477]/30 border-t-4 border-t-[#C8102E]" : "border-[#E2E8F0] border-t-4 border-t-[#174477] hover:border-t-[#C8102E]")">
                        
                        <!-- Card Surface -->
                        <div class="p-6 sm:p-7 flex flex-col justify-between">
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-mono font-bold tracking-widest text-[#174477] uppercase bg-[#EBF2FA] px-3 py-1 rounded-md border border-[#CBD5E1]">
                                        @item.Badge
                                    </span>
                                    @if (hasInteractiveLesson)
                                    {
                                        <span class="text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-300 px-2 py-0.5 rounded-full inline-flex items-center gap-1 shadow-2xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                            Online Lesson @item.Order
                                        </span>
                                    }
                                </div>
                                <span class="text-xs text-[#64748B] font-semibold uppercase tracking-wider">
                                    @item.Subtitle
                                </span>
                            </div>

                            <h3 class="text-xl sm:text-2xl font-bold text-[#001F5C] mb-2 tracking-tight" style="font-family: var(--font-heading, 'Playfair Display', Georgia, serif);">
                                @item.Title
                            </h3>
                            <p class="text-[#5A5A5A] text-sm leading-relaxed mb-6" style="font-family: var(--font-body, 'Montserrat', sans-serif);">
                                @item.ShortSummary
                            </p>

                            <button type="button" 
                                    @onclick="() => ToggleItem(item.Order)" 
                                    class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-lg font-bold text-xs uppercase tracking-wider transition-all duration-200 cursor-pointer @(isExpanded ? "bg-[#174477] text-white shadow-inner border border-[#174477]" : "bg-[#F8FAFC] text-[#174477] border border-[#CBD5E1] hover:bg-[#EBF2FA] hover:text-[#001F5C]")">
                                <span>@(isExpanded ? "Collapse Overview" : "Examine Blueprint")</span>
                                <svg class="w-4 h-4 transform transition-transform duration-300 @(isExpanded ? "rotate-180 text-white" : "text-[#174477]")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        </div>

                        <!-- Expandable Deep Study Body -->
                        @if (isExpanded)
                        {
                            <div class="px-6 sm:px-7 pb-7 pt-4 border-t border-[#E2E8F0] bg-[#F4F7FB] animate-fadeIn">
                                <h4 class="text-xs font-bold text-[#174477] mb-2 uppercase tracking-wider" style="font-family: var(--font-body, 'Montserrat', sans-serif);">
                                    @item.HeaderLead
                                </h4>
                                <p class="text-sm text-[#475569] leading-relaxed mb-5" style="font-family: var(--font-body, 'Montserrat', sans-serif);">
                                    @item.FullExposition
                                </p>

                                @if (item.Scriptures != null && item.Scriptures.Any())
                                {
                                    <div class="rounded-xl bg-white border border-[#E2E8F0] border-l-4 border-l-[#174477] p-4 mb-5 shadow-sm">
                                        <span class="text-[11px] font-bold uppercase tracking-wider text-[#64748B] block mb-2">
                                            Scriptural Foundation
                                        </span>
                                        <ul class="space-y-2">
                                            @foreach (var sc in item.Scriptures)
                                            {
                                                <li class="flex items-start text-xs sm:text-sm text-[#475569]">
                                                    <span class="text-[#C8102E] font-bold mr-2 leading-none mt-1">•</span>
                                                    <div>
                                                        <strong class="text-[#001F5C] font-bold">@sc.Ref</strong>
                                                        <span class="text-[#475569]"> — @sc.Desc</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (hasInteractiveLesson)
                                {
                                    <div class="space-y-2.5">
                                        <a href="/foundations/lesson/@item.Order" 
                                           class="inline-flex items-center justify-center w-full px-4 py-3 rounded-lg text-xs font-bold uppercase tracking-wider bg-[#C8102E] hover:bg-[#A60D25] text-white transition-all duration-200 shadow-md hover:shadow-lg group">
                                            <span>Launch Foundation @item.Order Interactive Lesson &rarr;</span>
                                        </a>
                                        <a href="@GetStudyUrl(item)" 
                                           class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-white border border-[#CBD5E1] text-[#174477] hover:bg-[#EBF2FA] hover:text-[#001F5C] transition-all duration-200">
                                            <span>Or Request Guided Study with an Elder</span>
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a href="@GetStudyUrl(item)" 
                                       class="inline-flex items-center justify-center w-full px-4 py-3 rounded-lg text-xs font-bold uppercase tracking-wider bg-[#174477] hover:bg-[#6696C5] text-white transition-all duration-200 shadow-md hover:shadow-lg">
                                        <span>Request Guided Study: @item.Title</span>
                                        <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                        </svg>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </main>

        <!-- CACI Standardized FAQ Accordion -->
        @if (Config.Faqs != null && Config.Faqs.Any())
        {
            <section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#E2E8F0] scroll-mt-24">
                <div class="text-center mb-10">
                    <span class="text-xs font-bold tracking-widest text-[#174477] uppercase bg-white px-3 py-1 rounded-full border border-[#CBD5E1] shadow-sm">
                        Inquiries & Clarifications
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-bold text-[#001F5C] mt-3 mb-3" style="font-family: var(--font-heading, 'Playfair Display', Georgia, serif);">
                        Frequently Asked Questions
                    </h2>
                    <div class="divider mx-auto" style="height: 3px; width: 60px; background-color: var(--bishop-purple, #47306D); border-radius: 2px;"></div>
                </div>

                <div class="space-y-4">
                    @foreach (var faq in Config.Faqs)
                    {
                        <details class="group bg-white rounded-xl border border-[#E2E8F0] shadow-sm open:border-[#174477] open:shadow-md transition-all">
                            <summary class="flex items-center justify-between p-5 cursor-pointer list-none select-none">
                                <span class="text-base font-bold text-[#001F5C] group-hover:text-[#174477] transition-colors pr-4" style="font-family: var(--font-heading, 'Playfair Display', Georgia, serif);">
                                    @faq.Question
                                </span>
                                <span class="flex-shrink-0 text-[#174477] group-open:rotate-180 transition-transform">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </span>
                            </summary>
                            <div class="px-5 pb-5 text-[#475569] text-sm leading-relaxed border-t border-[#F1F5F9] bg-[#F8FAFC] pt-4 rounded-b-xl" style="font-family: var(--font-body, 'Montserrat', sans-serif);">
                                @faq.Answer
                            </div>
                        </details>
                    }
                </div>
            </section>
        }
    </div>
}

<style>
    .caci-funnel-hero {
        position: static !important;
    }
    .caci-funnel-engine details summary::-webkit-details-marker {
        display: none;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
        animation: fadeIn 0.25s ease-out;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public FunnelConfiguration Config { get; set; } = default!;

    [Parameter]
    public bool IsSubsiteMode { get; set; }

    private int? activeItemId;

    protected override void OnInitialized()
    {
        // Check for URI fragment or slug matching
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var fragment = uri.Fragment.TrimStart('#');
            if (!string.IsNullOrEmpty(fragment))
            {
                var matched = Config?.Items?.FirstOrDefault(i => 
                    string.Equals(i.Slug, fragment, StringComparison.OrdinalIgnoreCase));
                if (matched != null)
                {
                    activeItemId = matched.Order;
                    return;
                }
            }
        }
        catch
        {
            // Ignore URI parse error on fallback
        }

        // Default first card open for engagement
        if (Config?.Items?.Any() == true)
        {
            activeItemId = Config.Items.First().Order;
        }
    }

    private void ToggleItem(int order)
    {
        activeItemId = activeItemId == order ? null : order;
    }

    private string GetStudyUrl(FunnelItem item)
    {
        var baseUrl = string.IsNullOrWhiteSpace(Config.StudyRequestBaseUrl) 
            ? "/request-bible-study" 
            : Config.StudyRequestBaseUrl;

        var separator = baseUrl.Contains('?') ? "&" : "?";
        return $"{baseUrl}{separator}key={Uri.EscapeDataString(item.TargetStudyKey)}";
    }

    private string GenerateJsonLd()
    {
        var graphList = new List<object>
        {
            new {
                type = "WebSite",
                id = "https://caci.life/#website",
                url = "https://caci.life",
                name = "CACI Life",
                publisher = new {
                    type = "Church",
                    name = "Covenant Apostolic Congregations International",
                    alternateName = "CACI",
                    url = "https://caci.life",
                    logo = "https://caci.life/images/logos/AllTheWord_NOTextLogo.png",
                    sameAs = new[] {
                        "https://www.facebook.com/THECACI",
                        "https://www.youtube.com/@THECACI"
                    }
                }
            },
            new {
                type = "WebPage",
                id = $"{Config.CanonicalUrl}#webpage",
                url = Config.CanonicalUrl,
                name = Config.MainTitle,
                description = Config.SubtitleLead,
                isPartOf = new {
                    id = "https://caci.life/#website"
                },
                about = Config.CategoryBadge,
                inLanguage = "en-US"
            }
        };

        if (Config.Items != null && Config.Items.Any())
        {
            var listItems = Config.Items.Select(item => new
            {
                type = "ListItem",
                position = item.Order,
                name = item.Title,
                description = item.ShortSummary,
                url = $"{Config.CanonicalUrl}#{item.Slug}"
            });

            graphList.Add(new
            {
                type = "ItemList",
                id = $"{Config.CanonicalUrl}#blueprint-list",
                name = Config.MainTitle,
                numberOfItems = Config.Items.Count,
                itemListElement = listItems
            });
        }

        if (Config.Faqs != null && Config.Faqs.Any())
        {
            var faqItems = Config.Faqs.Select(f => new
            {
                type = "Question",
                name = f.Question,
                acceptedAnswer = new
                {
                    type = "Answer",
                    text = f.Answer
                }
            });

            graphList.Add(new
            {
                type = "FAQPage",
                id = $"{Config.CanonicalUrl}#faq",
                mainEntity = faqItems
            });
        }

        var schemaObj = new
        {
            context = "https://schema.org",
            graph = graphList
        };

        // Output raw formatted JSON replacing schema property markers
        return JsonSerializer.Serialize(schemaObj, new JsonSerializerOptions { WriteIndented = false })
            .Replace("\"type\":", "\"@type\":")
            .Replace("\"context\":", "\"@context\":")
            .Replace("\"graph\":", "\"@graph\":");
    }
}
