@page "/login"
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<PageTitle>Login | CACI</PageTitle>

<div class="min-h-screen bg-[#001F5C] text-white flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white/5 border border-white/10 rounded-2xl p-8 text-center backdrop-blur-md shadow-2xl transition-all">
        
        <div class="mb-6">
            <a href="/">
                <img src="images/logos/AllTheWord_NOTextLogo.png" alt="CACI Logo" class="h-16 w-16 mx-auto mb-4 hover:scale-105 transition-transform"/>
            </a>
            <h2 class="text-2xl font-heading font-bold italic text-white">Sign In to CACI</h2>
            <div class="h-0.5 w-16 bg-amber-400 mx-auto mt-2 rounded-full"></div>
        </div>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="mb-4 bg-emerald-500/15 border border-emerald-500/30 text-emerald-200 p-3.5 rounded-xl text-xs font-semibold text-center">
                @Message
            </div>
        }

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="mb-4 bg-red-500/15 border border-red-500/30 text-red-200 p-3.5 rounded-xl text-xs font-semibold text-center">
                @Error
            </div>
        }

        @if (IsGoogleConfigured)
        {
            <a href="/api/auth/google?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")"
               class="w-full py-3.5 px-4 mb-5 bg-white hover:bg-gray-100 text-[#001F5C] font-bold uppercase tracking-wider rounded-xl transition duration-150 shadow-md text-xs flex items-center justify-center gap-2.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#174477" d="M21.8 10.2H12v3.9h5.6c-.2 1.3-1.5 3.9-5.6 3.9-3.4 0-6.1-2.8-6.1-6.2s2.7-6.2 6.1-6.2c1.9 0 3.2.8 3.9 1.5l2.7-2.6C16.9 3 14.7 2 12 2 6.5 2 2 6.5 2 12s4.5 10 10 10c5.8 0 9.6-4.1 9.6-9.8 0-.7-.1-1.3-.2-2z" />
                </svg>
                Continue with Google
            </a>

            <div class="flex items-center gap-3 mb-5 text-blue-200/70 text-[11px] uppercase tracking-wider">
                <span class="flex-1 h-px bg-white/10"></span>
                <span>or sign in with email</span>
                <span class="flex-1 h-px bg-white/10"></span>
            </div>
        }

        <!-- Standard HTML Form posting to our internal login handler -->
        <form action="/login-handler?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "")" method="post" class="space-y-4 text-left">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-blue-200 mb-1">Email Address</label>
                <input type="email" name="email" required placeholder="name@example.com"
                       class="w-full bg-white/10 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500 transition duration-150" />
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-blue-200 mb-1">Password</label>
                <input type="password" name="password" required placeholder="••••••••"
                       class="w-full bg-white/10 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500 transition duration-150" />
            </div>

            <button type="submit" class="w-full py-4 bg-amber-500 hover:bg-amber-400 text-[#001F5C] font-bold uppercase tracking-widest rounded-xl transition duration-150 shadow-md text-xs mt-6">
                Sign In
            </button>
        </form>

        <!-- Create / Request Account Section -->
        <div class="mt-8 pt-6 border-t border-white/10 text-center">
            <p class="text-xs text-blue-200 mb-2.5">Don't have an approved account yet?</p>
            <a href="/register" class="block w-full py-3.5 px-4 rounded-xl bg-white/10 hover:bg-white/20 border border-white/15 text-white font-bold text-xs uppercase tracking-wider transition duration-150 shadow-sm">
                <i class="bi bi-person-plus-fill me-1.5 text-amber-400"></i> Request an Account
            </a>
        </div>

        <p class="mt-6 text-[11px] text-blue-300">
            Forgot credentials or locked out? Contact <a href="mailto:Contact@caci.life" class="text-amber-400 hover:underline">Contact@caci.life</a>.
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; } = "/";

    private bool IsGoogleConfigured =>
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
}
